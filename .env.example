# Analytics + search-engine verification (all optional)
# Copy to .env.local for development, or set in your hosting environment for production.
# Astro picks up vars prefixed with PUBLIC_ at build time and exposes them to client code.

# Google Analytics 4 measurement ID
# Find at https://analytics.google.com -> Admin -> Data Streams -> your web stream
# Example: G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console site verification token
# Find at https://search.google.com/search-console -> Settings -> Ownership verification -> HTML tag
# Paste just the content value (the token), not the full meta tag.
PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools verification token (optional)
# Find at https://www.bing.com/webmasters -> Add Site -> Meta tag method
PUBLIC_BING_VERIFICATION=
