---
/**
 * Site analytics + search-engine verification tags.
 *
 * Env vars (set in .env or hosting env). All optional -- a missing var
 * skips its block entirely so dev builds never emit empty tags.
 *
 *   PUBLIC_GA4_MEASUREMENT_ID         e.g. G-XXXXXXXXXX
 *   PUBLIC_GSC_VERIFICATION           Google Search Console token
 *   PUBLIC_BING_VERIFICATION          Bing Webmaster Tools token
 *
 * Privacy notes
 *   - GA4 is configured with anonymize_ip=true + ads_storage='denied'
 *     so user IPs are truncated and we don't drive any ad networks.
 *     This is a healthcare-adjacent property; we keep the analytics
 *     surface minimal and disclose it in the privacy policy.
 *   - All scripts use is:inline so Astro does not try to bundle them.
 */

const GA4_ID = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID as string | undefined;
const GSC_TOKEN = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
const BING_TOKEN = import.meta.env.PUBLIC_BING_VERIFICATION as string | undefined;
---
{GSC_TOKEN && <meta name="google-site-verification" content={GSC_TOKEN} />}
{BING_TOKEN && <meta name="msvalidate.01" content={BING_TOKEN} />}

{GA4_ID && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
    <script is:inline define:vars={{ GA4_ID }}>{`
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'granted'
      });
      gtag('config', GA4_ID, { anonymize_ip: true });
    `}</script>
  </>
)}
