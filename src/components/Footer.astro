---
const expertise = ['Medicare', 'Medicaid', 'Private Insurance', 'Medicaid Room & Board'];

const serving = [
  { label: 'Hospice', href: '/services' },
  { label: 'Home Health', href: '/services' },
  { label: 'Palliative Care', href: '/services' },
  { label: 'Private Practices', href: '/services' },
];

const services = [
  { label: 'Collection / Reimbursement', href: '/services' },
  { label: 'Monthly Reporting', href: '/services' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'FAQ', href: '/faq' },
  { label: 'ROI Calculator', href: '/roi-calculator' },
  { label: 'Resources', href: '/resources' },
];

const badges = [
  {
    label: 'HIPAA Compliant',
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
  {
    label: 'AAPC Certified',
    icon: 'M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5',
  },
  {
    label: 'SOC 2 Compliant',
    icon: 'M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z',
  },
];

const currentYear = new Date().getFullYear();
---
<footer class="footer-gradient text-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      {/* Brand */}
      <div>
        <img src="/logo-white.svg" alt="CPS Medical Billing" width="200" height="56" class="h-14 w-auto mb-4" />
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Complete Professional Solutions for healthcare billing.
          Your trusted partner in revenue cycle management.
        </p>
        <div class="space-y-3">
          <a href="tel:801-341-9304" class="flex items-center gap-2.5 text-sm text-teal-400 hover:text-teal-300 transition-colors group">
            <svg class="w-4 h-4 flex-shrink-0 text-teal-500 group-hover:text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>801-341-9304</span>
          </a>
          <a href="mailto:completeprosolns@gmail.com" class="flex items-start gap-2.5 text-sm text-teal-400 hover:text-teal-300 transition-colors group break-all">
            <svg class="w-4 h-4 flex-shrink-0 text-teal-500 group-hover:text-teal-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <span>completeprosolns@gmail.com</span>
          </a>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-700/40">
          <p class="text-xs text-slate-500 uppercase tracking-wider mb-1.5">Sister brand</p>
          <a href="https://mira.ai" target="_blank" rel="noopener noreferrer" class="text-sm text-teal-400 hover:text-teal-300 transition-colors inline-flex items-center gap-1">
            <span>Mira — AI-native platform</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

      {/* Our Expertise */}
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-300 mb-5">
          Our Expertise
        </h4>
        <ul class="space-y-3">
          {expertise.map((item) => (
            <li>
              <span class="footer-link text-sm block">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Proudly Serving */}
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-300 mb-5">
          Proudly Serving
        </h4>
        <ul class="space-y-3">
          {serving.map((item) => (
            <li>
              <a href={item.href} class="footer-link text-sm block">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Our Services */}
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-300 mb-5">
          Our Services
        </h4>
        <ul class="space-y-3">
          {services.map((item) => (
            <li>
              <a href={item.href} class="footer-link text-sm block">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Newsletter slot (filled by blog page in T18) */}
    <slot name="newsletter" />

    {/* Compliance badges */}
    <div class="mt-12 pt-8 border-t border-white/10">
      <div class="flex flex-wrap justify-center items-center gap-6 mb-8">
        {badges.map((badge) => (
          <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10">
            <svg class="w-4 h-4 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={badge.icon} />
            </svg>
            <span class="text-xs text-slate-400 font-medium">{badge.label}</span>
          </div>
        ))}
      </div>
    </div>

    {/* Bottom bar */}
    <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-500 text-sm">
        &copy; {currentYear} CPS Medical Billing. All Rights Reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="text-slate-500 text-sm hover:text-teal-400 transition-colors">
          Privacy Policy
        </a>
        <a href="/terms" class="text-slate-500 text-sm hover:text-teal-400 transition-colors">
          Terms of Service
        </a>
        <a href="/contact" class="text-slate-500 text-sm hover:text-teal-400 transition-colors">
          Contact Us
        </a>
      </div>
    </div>
  </div>
</footer>
