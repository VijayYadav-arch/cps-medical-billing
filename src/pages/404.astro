---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you requested doesn't exist.">
  <section class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center max-w-md">
      <h1 class="font-serif text-5xl text-navy-900 mb-4">404</h1>
      <p class="text-slate-600 mb-8">We couldn't find that page.</p>
      <a href="/" class="inline-block bg-teal-600 text-white px-6 py-3 rounded-md hover:bg-teal-700">Back to home</a>
    </div>
  </section>
</BaseLayout>
