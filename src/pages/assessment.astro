---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { InquiryForm } from '@/islands/InquiryForm';

const ASSESSMENT_CARDS = [
  {
    title: 'Claims Analysis',
    description:
      'Review of current claim submission rates, denial patterns, and resubmission workflows.',
    iconPath:
      'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m5.231 13.481L15 17.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v16.5c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9zm3.75 11.625a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z',
  },
  {
    title: 'Revenue Leakage Audit',
    description:
      'Identification of underpayments, missed charges, and uncollected balances.',
    iconPath:
      'M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'A/R Aging Review',
    description:
      'Analysis of accounts receivable aging and collection timeline optimization.',
    iconPath: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Payer Mix Analysis',
    description:
      'Evaluation of payer contracts and reimbursement rate benchmarking.',
    iconPath:
      'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
  },
  {
    title: 'Compliance Check',
    description: 'Assessment of coding accuracy and regulatory compliance.',
    iconPath:
      'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
  {
    title: 'Custom Recommendations',
    description:
      'Tailored action plan with specific steps to improve your revenue cycle.',
    iconPath:
      'M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z',
  },
];

const STEPS = [
  {
    number: '1',
    title: 'Submit Your Info',
    description:
      'Fill out the form below with basic practice details. It only takes a couple of minutes.',
  },
  {
    number: '2',
    title: 'We Analyze',
    description:
      'Our team reviews your billing data and identifies opportunities for improvement.',
  },
  {
    number: '3',
    title: 'Get Your Report',
    description:
      'Receive a detailed assessment with actionable recommendations to boost revenue.',
  },
];

const TRUST_BADGES = [
  'HIPAA Compliant',
  '10+ Years Experience',
  '98% Collection Rate',
  '24hr Response Time',
];
---

<BaseLayout
  title="Free Revenue Cycle Assessment"
  description="Free no-obligation analysis of your billing operations. Most practices we assess find 15-25% in recoverable revenue."
>
  <!-- ===== HERO ===== -->
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/financial-report.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
        No Cost, No Obligation
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
        <span class="text-teal-400">Free</span> Revenue Cycle Assessment
      </h1>
      <p class="text-slate-300 text-lg leading-relaxed max-w-2xl mx-auto mb-10">
        Discover how much revenue your practice may be leaving on the table.
        Our experts will analyze your current billing process and identify
        opportunities for improvement.
      </p>
      <div class="flex flex-wrap justify-center gap-8 text-white">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-teal-400/20 flex items-center justify-center">
            <svg
              class="w-5 h-5 text-teal-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.5 12.75l6 6 9-13.5"
              />
            </svg>
          </div>
          <div class="text-left">
            <p class="text-xl font-bold">98%</p>
            <p class="text-sm text-slate-300">Average Collection Rate</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-teal-400/20 flex items-center justify-center">
            <svg
              class="w-5 h-5 text-teal-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.5 12.75l6 6 9-13.5"
              />
            </svg>
          </div>
          <div class="text-left">
            <p class="text-xl font-bold">10+</p>
            <p class="text-sm text-slate-300">Years Experience</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHAT'S INCLUDED ===== -->
  <section class="bg-cream py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
            Comprehensive Review
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
            What Your Free Assessment Covers
          </h2>
          <div class="section-line mx-auto" />
        </div>
      </ScrollReveal>

      <ScrollReveal direction="stagger">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            ASSESSMENT_CARDS.map((card) => (
              <div class="bg-white rounded-2xl p-7 card-hover card-teal-top shadow-sm border border-slate-100">
                <div class="icon-box mb-5">
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={card.iconPath}
                    />
                  </svg>
                </div>
                <h3 class="font-serif text-lg text-navy-900 mb-2">
                  {card.title}
                </h3>
                <p class="text-slate-600 text-sm leading-relaxed">
                  {card.description}
                </p>
              </div>
            ))
          }
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
            Simple Process
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
            How It Works
          </h2>
          <div class="section-line mx-auto" />
        </div>
      </ScrollReveal>

      <ScrollReveal direction="stagger">
        <div class="grid md:grid-cols-3 gap-12">
          {
            STEPS.map((step, idx) => (
              <div class="text-center relative">
                {idx < STEPS.length - 1 && (
                  <div class="hidden md:block absolute top-10 left-[calc(50%+40px)] w-[calc(100%-80px)] h-0.5 bg-teal-200">
                    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-0 h-0 border-t-[5px] border-t-transparent border-b-[5px] border-b-transparent border-l-[8px] border-l-teal-400" />
                  </div>
                )}
                <div class="w-20 h-20 rounded-full bg-teal-600 text-white flex items-center justify-center mx-auto mb-6 text-2xl font-bold relative z-10">
                  {step.number}
                </div>
                <h3 class="font-serif text-xl text-navy-900 mb-3">
                  {step.title}
                </h3>
                <p class="text-slate-600 text-sm leading-relaxed max-w-xs mx-auto">
                  {step.description}
                </p>
              </div>
            ))
          }
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- ===== ASSESSMENT FORM ===== -->
  <section id="form" class="bg-cream py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-16">
        <!-- Left Info Column -->
        <div class="lg:col-span-2">
          <ScrollReveal direction="left">
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Get Started
            </span>
            <h2 class="font-serif text-3xl text-navy-900 mt-3 mb-6">
              Request Your Free Assessment
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-8">
              Fill out the form and our revenue cycle experts will conduct a
              thorough analysis of your current billing operations at
              absolutely no cost.
            </p>

            <div class="p-6 bg-white rounded-xl border border-slate-100 shadow-sm mb-8">
              <svg
                class="w-8 h-8 text-teal-400 mb-3"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
                />
              </svg>
              <p class="text-navy-900 font-medium leading-relaxed italic">
                &ldquo;Most practices we assess discover 15-25% in
                recoverable revenue.&rdquo;
              </p>
            </div>

            <div class="p-6 bg-white rounded-xl border border-slate-100 shadow-sm">
              <p class="text-sm text-slate-500 mb-1">
                Prefer to talk? Call us directly.
              </p>
              <a
                href="tel:801-341-9304"
                class="text-xl font-bold text-navy-900 hover:text-teal-600 transition-colors"
              >
                801-341-9304
              </a>
              <p class="text-sm text-slate-500 mt-1">Mon - Sat, 10AM - 6PM</p>
            </div>
          </ScrollReveal>
        </div>

        <!-- Right Form Column -->
        <div class="lg:col-span-3">
          <ScrollReveal direction="right">
            <InquiryForm
              client:load
              title="Practice Details"
              submitLabel="Request Free Assessment"
              messageLabel="Tell us about your current billing challenges"
              messagePlaceholder="Describe your practice size, current billing setup, and any specific pain points..."
            />
          </ScrollReveal>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TRUST SECTION ===== -->
  <section class="quote-bg py-16">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 relative z-10 text-center">
      <p class="text-lg text-slate-300 mb-8">
        Trusted by healthcare practices across the nation
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {
          TRUST_BADGES.map((item) => (
            <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 text-white text-sm font-medium border border-white/15">
              <svg
                class="w-4 h-4 text-teal-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.5 12.75l6 6 9-13.5"
                />
              </svg>
              {item}
            </span>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
