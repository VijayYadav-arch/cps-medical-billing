---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

const endpoints = [
  { method: "GET", path: "/api/v1/patients", description: "List patients (paginated)" },
  { method: "POST", path: "/api/v1/patients", description: "Create a patient" },
];

const rateLimits = [
  { plan: "Free", limit: "100 requests/day" },
  { plan: "Starter", limit: "1,000 requests/day" },
  { plan: "Professional", limit: "10,000 requests/day" },
  { plan: "Enterprise", limit: "100,000 requests/day" },
];

function badgeColor(method: string): string {
  if (method === "GET") return "bg-emerald-100 text-emerald-700";
  if (method === "POST") return "bg-blue-100 text-blue-700";
  if (method === "DELETE") return "bg-red-100 text-red-700";
  return "bg-slate-100 text-slate-700";
}

const exampleRequest = `curl -X GET <your-api-host>/api/v1/patients \\
  -H "Authorization: Bearer cps_sk_a1b2c3d4e5f6..."\\
  -H "Content-Type: application/json"`;

const paginatedRequest = `curl -X GET "<your-api-host>/api/v1/patients?page=2&pageSize=10" \\
  -H "Authorization: Bearer cps_sk_a1b2c3d4e5f6..."`;

const responseFormat = `{
  "data": [ ... ],
  "pagination": {
    "total": 154,
    "page": 2,
    "pageSize": 10,
    "totalPages": 16,
    "hasMore": true
  }
}`;

const rateLimitHeaders = `X-RateLimit-Limit: 10000
X-RateLimit-Remaining: 9954
X-RateLimit-Reset: 1713100800`;

const errorFormat = `{
  "error": {
    "code": "UNAUTHORIZED",
    "message": "Invalid API key"
  }
}`;
---
<BaseLayout
  title="Developer Documentation"
  description="CPS Medical Billing API documentation. Learn how to integrate with our REST API for patients."
>
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/billing-paperwork.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <ScrollReveal>
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
            API Reference
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
            API Documentation
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
            Integrate CPS Medical Billing into your systems with our RESTful API.
            Manage patients, claims, encounters, and more programmatically.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== AUTHENTICATION ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
          Getting Started
        </span>
        <h2 class="font-serif text-3xl text-navy-900 mt-3 mb-4">
          Authentication
        </h2>
        <div class="section-line mb-8" />

        <div class="space-y-6 text-slate-600 leading-relaxed">
          <p>
            All API requests must include a valid API key in the{" "}
            <code class="px-1.5 py-0.5 bg-slate-100 rounded text-sm font-mono text-navy-900">Authorization</code> header
            using the Bearer scheme.
          </p>

          <div class="space-y-4">
            <h3 class="font-semibold text-navy-900 text-lg">1. Generate an API Key</h3>
            <p>
              Navigate to <strong>Portal &rarr; API Keys</strong> to create a new API key.
              Keys are prefixed with{" "}
              <code class="px-1.5 py-0.5 bg-slate-100 rounded text-sm font-mono text-navy-900">cps_sk_</code>{" "}
              and are shown in full only once at creation. Store them securely.
            </p>
          </div>

          <div class="space-y-4">
            <h3 class="font-semibold text-navy-900 text-lg">2. Include in Requests</h3>
            <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-900">
              <div class="px-4 py-2 bg-slate-800 border-b border-slate-700 text-xs text-slate-400 font-mono">
                Example Request
              </div>
              <pre class="p-4 overflow-x-auto text-sm text-slate-300 leading-relaxed"><code>{exampleRequest}</code></pre>
            </div>
          </div>

          <div class="space-y-4">
            <h3 class="font-semibold text-navy-900 text-lg">3. API Key Scopes</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
                <thead class="bg-slate-50">
                  <tr>
                    <th class="px-4 py-3 text-left font-semibold text-navy-900">Scope</th>
                    <th class="px-4 py-3 text-left font-semibold text-navy-900">Permissions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <tr>
                    <td class="px-4 py-3 font-mono text-sm">read</td>
                    <td class="px-4 py-3">Read-only access to all endpoints</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-mono text-sm">write</td>
                    <td class="px-4 py-3">Read and create access to all endpoints</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-mono text-sm">admin</td>
                    <td class="px-4 py-3">Full access including webhook management</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== ENDPOINTS ===== */}
  <section class="bg-white py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
          API Reference
        </span>
        <h2 class="font-serif text-3xl text-navy-900 mt-3 mb-4">
          Endpoints
        </h2>
        <div class="section-line mb-8" />

        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-4 py-3 text-left font-semibold text-navy-900">Method</th>
                <th class="px-4 py-3 text-left font-semibold text-navy-900">Path</th>
                <th class="px-4 py-3 text-left font-semibold text-navy-900">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {endpoints.map((ep) => (
                <tr class="hover:bg-slate-50/50">
                  <td class="px-4 py-3">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-bold ${badgeColor(ep.method)}`}>
                      {ep.method}
                    </span>
                  </td>
                  <td class="px-4 py-3 font-mono text-sm text-navy-900">{ep.path}</td>
                  <td class="px-4 py-3 text-slate-600">{ep.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== PAGINATION ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
          Data Retrieval
        </span>
        <h2 class="font-serif text-3xl text-navy-900 mt-3 mb-4">
          Pagination
        </h2>
        <div class="section-line mb-8" />

        <div class="space-y-6 text-slate-600 leading-relaxed">
          <p>
            All list endpoints support page-based pagination using{" "}
            <code class="px-1.5 py-0.5 bg-slate-100 rounded text-sm font-mono text-navy-900">page</code> and{" "}
            <code class="px-1.5 py-0.5 bg-slate-100 rounded text-sm font-mono text-navy-900">pageSize</code> query parameters.
          </p>

          <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-900">
            <div class="px-4 py-2 bg-slate-800 border-b border-slate-700 text-xs text-slate-400 font-mono">
              Paginated Request
            </div>
            <pre class="p-4 overflow-x-auto text-sm text-slate-300 leading-relaxed"><code>{paginatedRequest}</code></pre>
          </div>

          <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-900">
            <div class="px-4 py-2 bg-slate-800 border-b border-slate-700 text-xs text-slate-400 font-mono">
              Response Format
            </div>
            <pre class="p-4 overflow-x-auto text-sm text-slate-300 leading-relaxed"><code>{responseFormat}</code></pre>
          </div>

          <p>
            The maximum <code class="px-1.5 py-0.5 bg-slate-100 rounded text-sm font-mono text-navy-900">pageSize</code>{" "}
            is <strong>100</strong>. If not specified, the default is <strong>20</strong>.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== RATE LIMITS ===== */}
  <section class="bg-white py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
          Usage Limits
        </span>
        <h2 class="font-serif text-3xl text-navy-900 mt-3 mb-4">
          Rate Limits
        </h2>
        <div class="section-line mb-8" />

        <div class="space-y-6 text-slate-600 leading-relaxed">
          <p>
            API requests are rate-limited per organization based on your plan tier.
            Rate limit information is included in response headers.
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
              <thead class="bg-slate-50">
                <tr>
                  <th class="px-4 py-3 text-left font-semibold text-navy-900">Plan</th>
                  <th class="px-4 py-3 text-left font-semibold text-navy-900">Rate Limit</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {rateLimits.map((rl) => (
                  <tr>
                    <td class="px-4 py-3 font-medium text-navy-900">{rl.plan}</td>
                    <td class="px-4 py-3">{rl.limit}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 class="font-semibold text-navy-900 text-lg">Response Headers</h3>
          <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-900">
            <div class="px-4 py-2 bg-slate-800 border-b border-slate-700 text-xs text-slate-400 font-mono">
              Rate Limit Headers
            </div>
            <pre class="p-4 overflow-x-auto text-sm text-slate-300 leading-relaxed"><code>{rateLimitHeaders}</code></pre>
          </div>

          <p>
            When the rate limit is exceeded, the API returns a{" "}
            <code class="px-1.5 py-0.5 bg-slate-100 rounded text-sm font-mono text-navy-900">429 Too Many Requests</code>{" "}
            response. Wait until the reset timestamp before retrying.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== ERROR FORMAT ===== */}
  <section class="bg-white py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
          Error Handling
        </span>
        <h2 class="font-serif text-3xl text-navy-900 mt-3 mb-4">
          Error Responses
        </h2>
        <div class="section-line mb-8" />

        <div class="space-y-6 text-slate-600 leading-relaxed">
          <p>
            All errors follow a consistent JSON format with a machine-readable code
            and a human-readable message.
          </p>

          <div class="rounded-xl overflow-hidden border border-slate-200 bg-slate-900">
            <div class="px-4 py-2 bg-slate-800 border-b border-slate-700 text-xs text-slate-400 font-mono">
              Error Response Format
            </div>
            <pre class="p-4 overflow-x-auto text-sm text-slate-300 leading-relaxed"><code>{errorFormat}</code></pre>
          </div>

          <h3 class="font-semibold text-navy-900 text-lg">Common Error Codes</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
              <thead class="bg-slate-50">
                <tr>
                  <th class="px-4 py-3 text-left font-semibold text-navy-900">HTTP Status</th>
                  <th class="px-4 py-3 text-left font-semibold text-navy-900">Code</th>
                  <th class="px-4 py-3 text-left font-semibold text-navy-900">Description</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr>
                  <td class="px-4 py-3 font-mono">400</td>
                  <td class="px-4 py-3 font-mono">BAD_REQUEST</td>
                  <td class="px-4 py-3">Missing or invalid request parameters</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-mono">401</td>
                  <td class="px-4 py-3 font-mono">UNAUTHORIZED</td>
                  <td class="px-4 py-3">Missing or invalid API key</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-mono">403</td>
                  <td class="px-4 py-3 font-mono">FORBIDDEN</td>
                  <td class="px-4 py-3">Insufficient API key scope</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-mono">404</td>
                  <td class="px-4 py-3 font-mono">NOT_FOUND</td>
                  <td class="px-4 py-3">Resource not found</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-mono">429</td>
                  <td class="px-4 py-3 font-mono">RATE_LIMITED</td>
                  <td class="px-4 py-3">Rate limit exceeded</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          Ready to Get Started?
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Log in to your portal to create an API key and start building
          integrations.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/portal/api-keys" class="btn-primary">
            <span>Manage API Keys</span>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a
            href="/contact"
            class="btn-outline-dark text-white border-white hover:bg-white hover:text-navy-900"
          >
            <span>Contact Support</span>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
