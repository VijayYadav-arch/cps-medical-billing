---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" description="La página solicitada no existe.">
  <section class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center max-w-md">
      <h1 class="font-serif text-5xl text-navy-900 mb-4">404</h1>
      <p class="text-slate-600 mb-8">No pudimos encontrar esa página.</p>
      <a href="/es/" class="inline-block bg-teal-600 text-white px-6 py-3 rounded-md hover:bg-teal-700">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
