---
import RasterImage from '@/components/RasterImage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

const stats = [
  { value: "10+", label: "Años de experiencia" },
  { value: "500+", label: "Reclamos procesados al mes" },
  { value: "98%", label: "Tasa de cobranza" },
  { value: "24h", label: "Tiempo de respuesta" },
];

const values = [
  {
    title: "Precisión",
    desc: "Manejamos cada reclamo con atención meticulosa al detalle, asegurando exactitud en la codificación, documentación y envío.",
    iconPath: "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Transparencia",
    desc: "Informes mensuales y comunicación abierta lo mantienen informado sobre su ciclo de ingresos en todo momento.",
    iconPath: "M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.64 0 8.577 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.64 0-8.577-3.007-9.963-7.178z",
    iconPath2: "M15 12a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Colaboración",
    desc: "No solo procesamos cuentas. Nos convertimos en una extensión de su equipo, comprometidos con el éxito de su consultorio.",
    iconPath: "M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z",
  },
];
---
<BaseLayout
  title="Acerca de nosotros"
  description="CPS Facturación Médica: 10+ años de experiencia en facturación de hospicio, salud en el hogar y cuidados paliativos. Equipo certificado AAPC, alineado con HIPAA y SOC 2."
>
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/medical-team.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <h1 class="font-serif text-4xl sm:text-5xl text-white mb-4">
        Acerca de nosotros
      </h1>
      <p class="text-slate-300 text-lg max-w-2xl mx-auto">
        Su socio de confianza en facturación médica
      </p>
    </div>
  </section>

  {/* ===== COMPANY STORY ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <RasterImage
              src="/images/medical-team.jpg"
              alt="El equipo de CPS Facturación Médica en discusión"
              class="w-full h-[500px] object-cover"
             loading="lazy" />
          </div>
        </ScrollReveal>

        <ScrollReveal direction="right">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Nuestra historia
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              Quiénes somos
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              CPS es una firma de facturación médica especializada en servicios
              de salud en el hogar. Nuestro equipo fundador está integrado por
              profesionales con más de 10 años de experiencia en áreas
              específicas de facturación.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Comprendemos los desafíos únicos que enfrentan los proveedores de
              salud en el complejo panorama de facturación actual. Nuestra
              misión es simplificar el ciclo de ingresos para que usted pueda
              dedicar su energía al cuidado del paciente.
            </p>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== STATS ===== */}
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal direction="stagger">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
          {stats.map((stat) => (
            <div class="text-center">
              <div class="text-4xl sm:text-5xl font-serif text-teal-600 font-bold mb-2">
                {stat.value}
              </div>
              <div class="text-sm text-slate-600">{stat.label}</div>
            </div>
          ))}
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== COMPLIANCE ===== */}
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <img
            src="/illustrations/compliance-shield.svg"
            alt="Cumplimiento HIPAA, SOC 2 y AAPC"
            class="w-full h-auto rounded-2xl"
           loading="lazy"/>
        </ScrollReveal>
        <ScrollReveal direction="right">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Confianza y cumplimiento
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              Seguridad y cumplimiento primero
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              Cada aspecto de nuestra operación está diseñado para proteger los
              datos de sus pacientes y mantener estricto cumplimiento con la
              normativa sanitaria. Mantenemos certificaciones del sector y
              seguimos los estándares más exigentes en el manejo de información
              de salud.
            </p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span class="text-slate-600"><strong class="text-navy-900">Conformidad con HIPAA</strong> &mdash; Acuerdos de socio comercial completos y registros de auditoría</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span class="text-slate-600"><strong class="text-navy-900">Alineado con SOC 2</strong> &mdash; Atestación anual de seguridad y controles</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span class="text-slate-600"><strong class="text-navy-900">Codificadores certificados AAPC</strong> &mdash; Credenciales estándar de la industria</span>
              </li>
            </ul>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== OUR VALUES ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
            Lo que nos impulsa
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
            Nuestros valores
          </h2>
          <div class="section-line mx-auto" />
        </div>
      </ScrollReveal>

      <ScrollReveal direction="stagger">
        <div class="grid md:grid-cols-3 gap-8">
          {values.map((value) => (
            <div class="card-hover card-teal-top bg-white rounded-2xl p-8 shadow-sm border border-slate-100">
              <div class="icon-box mb-6">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={value.iconPath} />
                  {value.iconPath2 && (
                    <path stroke-linecap="round" stroke-linejoin="round" d={value.iconPath2} />
                  )}
                </svg>
              </div>
              <h3 class="font-serif text-xl text-navy-900 mb-3">
                {value.title}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {value.desc}
              </p>
            </div>
          ))}
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== MISSION QUOTE ===== */}
  <section class="quote-bg py-20 lg:py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 relative z-10">
      <ScrollReveal>
        <blockquote class="text-center">
          <p class="font-serif text-2xl sm:text-3xl lg:text-4xl text-white leading-relaxed italic">
            &ldquo;Permita que CPS se encargue de su facturación para que usted
            pueda dedicar su atención al{' '}
            <span class="text-teal-300">cuidado del paciente.</span>&rdquo;
          </p>
        </blockquote>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== MARCA HERMANA: MIRA ===== */}
  <section class="py-20 bg-cream">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <span class="text-teal-700 text-xs font-bold uppercase tracking-widest mb-3 block">Marca hermana</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mb-4">Mira — plataforma con IA.</h2>
        <p class="text-slate-600 leading-relaxed mb-4">
          CPS Medical Billing opera el negocio de servicios administrados. <strong>Mira</strong> &mdash; nuestra marca hermana &mdash; entrega la plataforma de software con IA que naci&oacute; de la experiencia del mismo equipo en ciclos de ingresos. Cada marca tiene su propio enfoque, pero las construyen y operan las mismas personas.
        </p>
        <p class="text-slate-600 leading-relaxed">
          Si quiere que un equipo opere su ciclo de ingresos por usted, est&aacute; en el sitio correcto. Si quiere software que opere su equipo, <a href="https://mira.ai" class="text-teal-700 underline underline-offset-2 hover:text-teal-800 font-medium" target="_blank" rel="noopener noreferrer">visite Mira</a>.
        </p>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          Asóciese con CPS hoy
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Déjenos optimizar su ciclo de ingresos para que pueda concentrarse
          en brindar atención excepcional al paciente.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/es/contact" class="btn-primary">
            <span>Póngase en contacto</span>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a href="/services" class="btn-outline-dark text-white border-white hover:bg-white hover:text-navy-900">
            Nuestros servicios
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
