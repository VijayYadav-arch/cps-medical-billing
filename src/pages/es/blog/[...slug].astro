---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

/**
 * Spanish article pages. Collection slugs for Spanish articles look
 * like `es/5-common-hospice-billing-errors` (because the file lives at
 * blog/es/5-common-hospice-billing-errors.mdx). The route param strips
 * the `es/` prefix so the public URL becomes `/es/blog/<slug>` matching
 * the English URL exactly.
 */
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => p.data.locale === 'es');
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^es\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await post.render();

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat('es-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(d);
}

const category =
  post.data.tags && post.data.tags.length > 0 ? post.data.tags[0] : 'Artículo';
const heroSrc = post.data.hero ?? '/images/stethoscope.jpg';

const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://cpshealthcarebilling.com';
const slugWithoutPrefix = post.slug.replace(/^es\//, '');
const postUrl = `${SITE_URL}/es/blog/${slugWithoutPrefix}/`;
const heroUrl = `${SITE_URL}${heroSrc}`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.excerpt,
  image: heroUrl,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: SITE_URL,
  },
  publisher: { '@id': `${SITE_URL}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  articleSection: category,
  inLanguage: 'es-US',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE_URL}/es/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/es/blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
  ],
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  og={{
    title: post.data.title,
    description: post.data.excerpt,
    image: post.data.hero,
    type: 'article',
  }}
  extraJsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src={heroSrc} />
    <div class="hero-pattern" />
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <span class="inline-block px-3 py-1 rounded-full bg-teal-600 text-white text-xs font-semibold uppercase tracking-wider mb-4">
        {category}
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-white mb-4">
        {post.data.title}
      </h1>
      <p class="text-slate-300 text-sm">
        {formatDate(post.data.publishedAt)} · {post.data.author}
      </p>
    </div>
  </section>

  {/* ===== ARTICLE CONTENT ===== */}
  <section class="bg-white py-16">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        {/* Back link */}
        <a
          href="/es/blog"
          class="inline-flex items-center gap-2 text-teal-600 font-semibold hover:text-teal-700 transition-colors mb-10"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Volver al blog
        </a>

        {/* Featured image */}
        {post.data.hero && (
          <div class="rounded-2xl overflow-hidden shadow-xl mb-10">
            <img src={post.data.hero} alt={post.data.title} width={800} height={450} class="w-full h-[400px] object-cover"  loading="lazy"/>
          </div>
        )}

        {/* Article body — rendered from MDX */}
        <div class="prose prose-slate max-w-none prose-content">
          <Content />
        </div>

        {/* Divider */}
        <div class="section-line mx-auto my-12" />

        {/* CTA */}
        <div class="text-center">
          <h3 class="font-serif text-2xl text-navy-900 mb-4">
            ¿Listo para optimizar su facturación?
          </h3>
          <p class="text-slate-600 mb-6">
            Contacte a CPS Facturación Médica para conocer cómo podemos
            ayudar a su organización a maximizar ingresos y reducir
            denegaciones de reclamos.
          </p>
          <a href="/es/contact" class="btn-primary inline-flex">
            <span>Comenzar</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
