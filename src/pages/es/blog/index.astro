---
import RasterImage from '@/components/RasterImage.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { NewsletterForm } from '@/islands/NewsletterForm';

// Listing surfaces Spanish translations first (sorted by date) and
// then English-only articles that don't yet have a Spanish version.
// Spanish cards link to /es/blog/<slug>; English-only cards link to
// /blog/<slug> with a hreflang attribute and a visual "(en)" hint.
const allPosts = await getCollection('blog');
const spanishPosts = allPosts.filter((p) => p.data.locale === 'es');
const translatedSlugs = new Set(
  spanishPosts.map((p) => p.data.translationOfSlug ?? p.slug.replace(/^es\//, '')),
);
const englishOnly = allPosts
  .filter((p) => p.data.locale === 'en' && !translatedSlugs.has(p.slug))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const spanishSorted = spanishPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const featured = spanishSorted[0] ?? englishOnly[0];
const isFeaturedSpanish = featured && featured.data.locale === 'es';
const gridArticles = isFeaturedSpanish
  ? [...spanishSorted.slice(1), ...englishOnly]
  : englishOnly.slice(1);

function postHref(p: { slug: string; data: { locale?: string } }): string {
  return p.data.locale === 'es'
    ? `/es/blog/${p.slug.replace(/^es\//, '')}`
    : `/blog/${p.slug}`;
}

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat('es-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(d);
}

function categoryFor(tags: string[] | undefined): string {
  return tags && tags.length > 0 ? tags[0] : 'Artículo';
}
---
<BaseLayout
  title="Blog y recursos"
  description="Análisis del sector, consejos de facturación y actualizaciones regulatorias para ayudar a su consultorio a prosperar."
>
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/stethoscope.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <h1 class="font-serif text-4xl sm:text-5xl text-white mb-4">
        Blog y recursos
      </h1>
      <p class="text-slate-300 text-lg max-w-2xl mx-auto">
        Análisis del sector, consejos de facturación y actualizaciones
        regulatorias para ayudar a su consultorio a prosperar.
      </p>
    </div>
  </section>

  {/* ===== EN-CONTENT NOTE ===== */}
  <section class="bg-cream pt-12">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="bg-white rounded-xl border border-slate-200 p-5 text-sm text-slate-600 leading-relaxed">
        <strong class="text-navy-900">Nota:</strong>{' '}
        Los artículos del blog están disponibles en inglés. Hacer clic en
        cualquiera de las tarjetas abrirá el artículo en su idioma
        original. Estamos trabajando para traducir las publicaciones
        prioritarias al español.
      </div>
    </div>
  </section>

  {/* ===== FEATURED ARTICLE ===== */}
  {featured && (
    <section class="bg-cream py-16">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <ScrollReveal direction="left">
            <div class="rounded-2xl overflow-hidden shadow-xl">
              {featured.data.hero ? (
                <RasterImage
                  src={featured.data.hero}
                  alt={featured.data.title}
                  width={700}
                  height={460}
                  class="w-full h-[400px] object-cover"
                 loading="lazy" />
              ) : (
                <div class="w-full h-[400px] bg-gradient-to-br from-navy-900/10 to-teal-600/10" />
              )}
            </div>
          </ScrollReveal>

          <ScrollReveal direction="right">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-teal-600 text-white text-xs font-semibold uppercase tracking-wider mb-4">
                Destacado
              </span>
              <h2 class="font-serif text-2xl sm:text-3xl text-navy-900 mb-3">
                {featured.data.title}
              </h2>
              <p class="text-sm text-slate-600 mb-4">
                {formatDate(featured.data.publishedAt)}
              </p>
              <p class="text-slate-600 leading-relaxed mb-6">
                {featured.data.excerpt}
              </p>
              <a
                href={postHref(featured)}
                hreflang={featured.data.locale === 'es' ? 'es' : 'en'}
                class="inline-flex items-center gap-2 text-teal-600 font-semibold hover:text-teal-700 transition-colors"
              >
                {featured.data.locale === 'es' ? 'Leer más' : 'Leer más (en inglés)'}
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </ScrollReveal>
        </div>
      </div>
    </section>
  )}

  {/* ===== ARTICLE GRID ===== */}
  {gridArticles.length > 0 && (
    <section class="bg-white py-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <ScrollReveal>
          <div class="text-center mb-16">
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Manténgase informado
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
              Artículos recientes
            </h2>
            <div class="section-line mx-auto" />
          </div>
        </ScrollReveal>

        <ScrollReveal direction="stagger">
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {gridArticles.map((article) => (
              <a
                href={postHref(article)}
                hreflang={article.data.locale === 'es' ? 'es' : 'en'}
                class="card-hover bg-cream rounded-2xl overflow-hidden border border-slate-100 block"
              >
                {article.data.hero ? (
                  <RasterImage
                    src={article.data.hero}
                    alt={article.data.title}
                    width={400}
                    height={192}
                    class="w-full h-48 object-cover"
                   loading="lazy" />
                ) : (
                  <div class="w-full h-48 bg-gradient-to-br from-navy-900/10 to-teal-600/10" />
                )}

                <div class="p-6">
                  <span class="inline-block px-3 py-1 rounded-full bg-teal-100 text-teal-700 text-xs font-semibold uppercase tracking-wider mb-3">
                    {categoryFor(article.data.tags)}
                  </span>
                  <h3 class="font-serif text-lg text-navy-900 mb-2 leading-snug">
                    {article.data.title}
                  </h3>
                  <p class="text-xs text-slate-500 mb-3">
                    {formatDate(article.data.publishedAt)}
                  </p>
                  <p class="text-slate-600 text-sm leading-relaxed mb-4">
                    {article.data.excerpt}
                  </p>
                  <span class="inline-flex items-center gap-1.5 text-teal-600 text-sm font-semibold">
                    {article.data.locale === 'es' ? 'Leer más' : 'Leer más (en)'}
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </ScrollReveal>
      </div>
    </section>
  )}

  {/* ===== NEWSLETTER CTA ===== */}
  <section class="hero-gradient py-20 relative">
    <div class="hero-pattern absolute inset-0" />
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5">
          Manténgase al día
        </h2>
        <p class="text-slate-300 text-lg mb-10 max-w-2xl mx-auto">
          Reciba los últimos análisis de facturación, actualizaciones de
          CMS y consejos del sector directamente en su bandeja de entrada.
        </p>
        <NewsletterForm client:visible locale="es" />
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
