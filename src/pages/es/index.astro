---
<BaseLayout
  title="CPS Facturación Médica | Soluciones Profesionales Completas"
  isDefaultTitle={true}
  description="CPS es una empresa reconocida de facturación médica que atiende a organizaciones de salud, desde grandes centros hasta consultorios pequeños. Especialistas en Medicare, Medicaid y seguros privados."
  keywords={[
    'facturación médica',
    'facturación de salud',
    'facturación Medicare',
    'facturación Medicaid',
    'facturación de hospicio',
    'facturación de salud en el hogar',
    'facturación de cuidados paliativos',
    'gestión del ciclo de ingresos',
  ]}
  og={{
    title: 'CPS Facturación Médica | Soluciones Profesionales Completas',
    description: 'Empresa reconocida de facturación médica que atiende a organizaciones de salud. Especialistas en Medicare, Medicaid, hospicio, salud en el hogar y cuidados paliativos.',
    image: '/images/banner3.jpg',
  }}
  twitter={{
    title: 'CPS Facturación Médica | Soluciones Profesionales Completas',
    description: 'Facturación médica especializada en hospicio, salud en el hogar y cuidados paliativos. 10+ años de experiencia, 98 % de tasa de cobranza.',
    image: '/images/banner3.jpg',
  }}
>
  {/* ===== HERO ===== */}
  <section class="hero-gradient min-h-screen flex items-center relative overflow-hidden">
    <div class="hero-pattern" />

    {/* Animated gradient orbs */}
    <div class="absolute top-20 -left-20 w-96 h-96 rounded-full bg-teal-500/20 blur-3xl" style="animation: float 10s ease-in-out infinite" />
    <div class="absolute bottom-20 right-10 w-80 h-80 rounded-full bg-teal-400/10 blur-3xl" style="animation: float 12s ease-in-out infinite 2s" />

    {/* Floating crosses */}
    <div class="hero-cross w-10 h-10 top-[15%] left-[10%]" style="animation: float 8s ease-in-out infinite" />
    <div class="hero-cross w-6 h-6 top-[60%] left-[85%]" style="animation: float 10s ease-in-out infinite 2s" />
    <div class="hero-cross w-8 h-8 top-[80%] left-[20%]" style="animation: float 12s ease-in-out infinite 4s" />
    <div class="hero-cross w-5 h-5 top-[25%] left-[70%]" style="animation: float 9s ease-in-out infinite 1s" />

    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-24 pt-40 lg:pt-32 relative z-10 w-full">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="hero-animate-1 flex items-center gap-3 mb-6">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/30 backdrop-blur-sm">
              <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
              Su socio confiable en facturación médica
            </span>
          </div>
          <h1 class="hero-animate-1 font-serif text-4xl sm:text-5xl lg:text-[3.75rem] text-white leading-[1.1] mb-6">
            Soluciones profesionales{' '}
            <span class="relative inline-block">
              <span class="text-teal-400">completas</span>
              <svg class="absolute -bottom-2 left-0 w-full h-3" viewBox="0 0 100 10" preserveAspectRatio="none">
                <path d="M 0 5 Q 25 0 50 5 T 100 5" stroke="#2dd4bf" stroke-width="2" fill="none" opacity="0.6"/>
              </svg>
            </span>
            <br />para facturación médica
          </h1>
          <p class="hero-animate-2 text-lg text-slate-300 leading-relaxed mb-10 max-w-xl">
            Empresa reconocida de facturación médica que atiende a
            organizaciones que van desde grandes centros de salud hasta
            consultorios pequeños. Nosotros nos ocupamos de la facturación
            para que usted pueda dedicarse al cuidado del paciente.
          </p>
          <div class="hero-animate-3 flex flex-wrap gap-4 mb-10">
            <a href="/es/contact" class="btn-primary pulse-cta">
              <span>Solicitar evaluación gratuita</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/es/services" class="btn-outline">
              Explorar servicios
            </a>
          </div>

          {/* Trust indicators */}
          <div class="hero-animate-3 flex flex-wrap items-center gap-6 pt-6 border-t border-white/10">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
              <span class="text-sm text-slate-300">Conformidad HIPAA</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
              <span class="text-sm text-slate-300">10+ años de experiencia</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
              <span class="text-sm text-slate-300">98 % de tasa de cobranza</span>
            </div>
          </div>
        </div>

        {/* Right: Dashboard mockup card -- numerals stay as-is; only the chrome labels translate */}
        <div class="hero-animate-3 hidden lg:block relative">
          <div class="relative bg-white/95 backdrop-blur-lg rounded-2xl shadow-2xl p-6 border border-white/20">
            <div class="flex items-center justify-between mb-5 pb-4 border-b border-slate-100">
              <div>
                <div class="text-xs text-slate-500 font-medium uppercase tracking-wider">Ingresos del mes</div>
                <div class="text-2xl font-serif text-navy-900 font-bold mt-1">$487,250</div>
              </div>
              <div class="flex items-center gap-1.5 px-3 py-1 bg-teal-50 rounded-full">
                <svg class="w-4 h-4 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.306a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
                </svg>
                <span class="text-xs font-semibold text-teal-700">+22 %</span>
              </div>
            </div>

            <svg viewBox="0 0 280 100" class="w-full h-20 mb-5">
              <defs>
                <linearGradient id="chartGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#0d9488" stop-opacity="0.3"/>
                  <stop offset="100%" stop-color="#0d9488" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M 0 80 L 35 70 L 70 75 L 105 55 L 140 60 L 175 40 L 210 45 L 245 25 L 280 20 L 280 100 L 0 100 Z" fill="url(#chartGrad)"/>
              <path d="M 0 80 L 35 70 L 70 75 L 105 55 L 140 60 L 175 40 L 210 45 L 245 25 L 280 20" stroke="#0d9488" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="280" cy="20" r="4" fill="white" stroke="#0d9488" stroke-width="2"/>
            </svg>

            <div class="grid grid-cols-3 gap-3">
              <div class="bg-slate-50 rounded-lg p-3">
                <div class="text-[10px] text-slate-500 uppercase tracking-wider">Cobranza</div>
                <div class="text-lg font-bold text-navy-900 mt-0.5">98 %</div>
              </div>
              <div class="bg-slate-50 rounded-lg p-3">
                <div class="text-[10px] text-slate-500 uppercase tracking-wider">Días A/R</div>
                <div class="text-lg font-bold text-navy-900 mt-0.5">28</div>
              </div>
              <div class="bg-slate-50 rounded-lg p-3">
                <div class="text-[10px] text-slate-500 uppercase tracking-wider">Denegaciones</div>
                <div class="text-lg font-bold text-navy-900 mt-0.5">3.2 %</div>
              </div>
            </div>
          </div>

          <div class="absolute -top-4 -left-4 bg-teal-500 text-white text-xs font-semibold px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            Panel en vivo
          </div>

          <div class="absolute -bottom-6 -right-6 bg-white rounded-xl shadow-xl p-4 border border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-teal-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-slate-500">Certificado</div>
              <div class="text-sm font-bold text-navy-900">HIPAA seguro</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden lg:block">
      <div class="w-6 h-10 border-2 border-white/20 rounded-full flex justify-center pt-2">
        <div class="w-1 h-2 bg-white/40 rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  {/* ===== EXPERTISE ===== */}
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
            Lo que hacemos mejor
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
            Nuestra experiencia
          </h2>
          <div class="section-line mx-auto" />
        </div>
