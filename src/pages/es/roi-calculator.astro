---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { ROICalculator } from '@/islands/ROICalculator';

const METHODOLOGY = [
  {
    title: 'Referencias del sector',
    description:
      'Nuestras proyecciones se basan en nuestra tasa promedio de cobranza del 98 % en toda la base de clientes.',
  },
  {
    title: 'Estimaciones conservadoras',
    description:
      'Usamos estimaciones conservadoras. Los resultados reales pueden superar las proyecciones según su combinación específica de pagadores.',
  },
  {
    title: 'Historial comprobado',
    description:
      'Nuestros clientes ven un aumento promedio del 22 % en cobranzas dentro de los primeros 90 días.',
  },
];
---

<BaseLayout
  title="Calculadora de recuperación de ingresos"
  description="Vea cuántos ingresos adicionales podría recuperar CPS para su consultorio con nuestra calculadora gratuita de ROI."
>
  <!-- ===== HERO ===== -->
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/financial-report.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
        Herramienta gratuita
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
        Calculadora de <span class="text-teal-400">ingresos</span>
      </h1>
      <p class="text-slate-300 text-lg leading-relaxed max-w-2xl mx-auto">
        Vea cuántos ingresos adicionales podría recuperar CPS para su consultorio.
      </p>
    </div>
  </section>

  <!-- ===== CALCULATOR SECTION ===== -->
  <section class="bg-cream py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ROICalculator client:load locale="es" />
    </div>
  </section>

  <!-- ===== HOW WE CALCULATE ===== -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-12">
          <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
            Nuestra metodología
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
            Cómo calculamos
          </h2>
          <div class="section-line mx-auto" />
        </div>
      </ScrollReveal>

      <ScrollReveal direction="stagger">
        <div class="grid md:grid-cols-3 gap-8">
          {METHODOLOGY.map((item) => (
            <div class="bg-cream rounded-2xl p-7 card-hover shadow-sm border border-slate-100 text-center">
              <div class="w-12 h-12 rounded-full bg-teal-600/10 text-teal-600 flex items-center justify-center mx-auto mb-5">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
              </div>
              <h3 class="font-serif text-lg text-navy-900 mb-2">{item.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          Obtenga su evaluación personalizada
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Nuestros expertos analizarán su situación específica y entregarán
          un plan detallado de recuperación de ingresos.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/es/contact" class="btn-primary">
            <span>Solicitar evaluación gratuita</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="tel:801-341-9304" class="btn-outline-dark text-white border-white hover:bg-white hover:text-navy-900">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>Llamar al 801-341-9304</span>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
