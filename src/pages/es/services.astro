---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

interface ServiceItem {
  label: string;
}

interface ServiceSection {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  image: string;
  imageAlt: string;
  items: ServiceItem[];
  imageFirst: boolean;
}

const services: ServiceSection[] = [
  {
    id: "hospice",
    title: "Facturación de hospicio",
    subtitle: "Facturación integral de cuidados al final de la vida",
    description:
      "Nuestro equipo de facturación de hospicio garantiza el envío preciso y oportuno de los reclamos en todos los pagadores. Gestionamos el ciclo de ingresos completo para que su equipo pueda concentrarse en brindar atención compasiva.",
    image: "/images/hospice-care.jpg",
    imageAlt: "Profesionales de hospicio con pacientes",
    items: [
      { label: "Facturación de todos los pagadores incluyendo Medicare, Medicaid y seguros comerciales" },
      { label: "Procesamiento de reclamos incluyendo NOE, NOTR y facturación mensual" },
      { label: "Registro de pagos y revisión de remesas" },
      { label: "Gestión y seguimiento de cuentas por cobrar" },
      { label: "Informes diarios y mensuales con proyecciones de ingresos" },
      { label: "Verificación de elegibilidad y revisión de beneficios" },
      { label: "Inscripción y configuración de EDI y EFT" },
      { label: "Inscripción de pagadores y configuración del software" },
    ],
    imageFirst: true,
  },
  {
    id: "home-health",
    title: "Facturación de salud en el hogar",
    subtitle: "Ciclo de ingresos optimizado para salud en el hogar",
    description:
      "Brindamos soporte integral de facturación para agencias de salud en el hogar, asegurando reclamos limpios y reembolsos máximos desde el primer día.",
    image: "/images/home-health.jpg",
    imageAlt: "Cuidadora de salud en el hogar con paciente",
    items: [
      { label: "Envíos diarios de NOA y procesamiento de reclamos" },
      { label: "Análisis de A/R, seguimiento y gestión de denegaciones" },
      { label: "Informes financieros y operativos mensuales" },
      { label: "Servicios complementarios de credencialización y apoyo a pagadores" },
    ],
    imageFirst: false,
  },
  {
    id: "palliative",
    title: "Facturación de cuidados paliativos",
    subtitle: "Gestión especializada de ingresos en cuidados paliativos",
    description:
      "Nuestro equipo comprende los requisitos únicos de codificación y facturación de los cuidados paliativos, ayudando a su consultorio a capturar cada dólar ganado.",
    image: "/images/palliative-care.jpg",
    imageAlt: "Médico de cuidados paliativos con paciente",
    items: [
      { label: "Envíos diarios de reclamos a todos los pagadores" },
      { label: "Informes mensuales con análisis detallado de ingresos" },
      { label: "Gestión de cuentas por cobrar y seguimiento de cobranzas" },
    ],
    imageFirst: true,
  },
];

const emrs = [
  "Axxess",
  "HCHB (Homecare Homebase)",
  "MatrixCare",
  "Brightree",
  "KanTime",
  "Netsmart",
  "WellSky",
  "Kinnser",
  "PointClickCare",
  "Thornberry",
];

const onboardingSteps = [
  {
    step: 1,
    title: "Semana 1: Descubrimiento",
    description:
      "Revisamos sus operaciones de facturación actuales, la configuración del EMR y las relaciones con los pagadores para comprender el panorama completo antes de realizar cualquier cambio.",
  },
  {
    step: 2,
    title: "Semana 2: Configuración",
    description:
      "Acceso al EMR, verificación de inscripción de pagadores, presentaciones del equipo y diseño de flujos de trabajo adaptados a las necesidades de su agencia.",
  },
  {
    step: 3,
    title: "Semana 3: Transición",
    description:
      "Toma gradual de los reclamos activos, limpieza histórica y pruebas exhaustivas de procesos para asegurar que nada se pase por alto.",
  },
  {
    step: 4,
    title: "Semana 4+: Servicio completo",
    description:
      "Operaciones de facturación completas, envíos diarios, informes mensuales y optimización continua de su ciclo de ingresos.",
  },
];

const reportingFeatures = [
  "Antigüedad de A/R por pagador en tiempo real",
  "Depósitos diarios de cobranza y tendencias",
  "Seguimiento y análisis de la tasa de denegaciones",
  "Análisis de combinación de pagadores y reembolsos",
  "Seguimiento de envíos de reclamos y rechazos",
  "Resúmenes mensuales de desempeño financiero",
];

const codingItems = [
  {
    title: "ICD-10-CM/PCS",
    description:
      "Codificación experta para todos los códigos de diagnóstico y procedimientos específicos de hospicio, salud en el hogar y cuidados paliativos.",
  },
  {
    title: "CPT y HCPCS",
    description:
      "Codificación precisa de procedimientos para todos los servicios facturables, incluyendo E/M, gestión de cuidados y códigos de planificación anticipada.",
  },
  {
    title: "Códigos de ingreso",
    description:
      "Asignación correcta de códigos de ingreso para todos los servicios institucionales en Medicare, Medicaid y pagadores comerciales.",
  },
];
---
<BaseLayout
  title="Servicios"
  description="Servicios de facturación médica para hospicio, salud en el hogar y cuidados paliativos. Expertos en todos los pagadores principales y EMRs."
>
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/hero-healthcare.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <ScrollReveal>
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
            Lo que ofrecemos
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
            Nuestros servicios
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed mb-10 max-w-2xl mx-auto">
            Impulsamos la atención sanitaria y elevamos sus ingresos: CPS, su
            socio en soluciones integrales de facturación médica.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="tel:801-341-9304" class="btn-primary">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              <span>Llámenos</span>
            </a>
            <a href="/es/contact" class="btn-outline">
              Dejar un mensaje
            </a>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== SERVICE SECTIONS ===== */}
  {services.map((service, index) => {
    const bgClass = index % 2 === 0 ? "bg-white" : "bg-cream";
    const imageDirection = service.imageFirst ? "left" : "right";
    const contentDirection = service.imageFirst ? "right" : "left";

    return (
      <section class={`py-24 ${bgClass}`}>
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <div class="grid lg:grid-cols-2 gap-16 items-center">
            {service.imageFirst ? (
              <>
                <ScrollReveal direction={imageDirection} delay={100}>
                  <div class="relative">
                    <div class="rounded-2xl overflow-hidden shadow-xl">
                      <img
                        src={service.image}
                        alt={service.imageAlt}
                        class="w-full h-[400px] object-cover rounded-2xl shadow-xl"
                       loading="lazy"/>
                    </div>
                  </div>
                </ScrollReveal>
                <ScrollReveal direction={contentDirection} delay={200}>
                  <div>
                    <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
                      {service.subtitle}
                    </span>
                    <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
                      {service.title}
                    </h2>
                    <div class="section-line mb-6" />
                    <p class="text-slate-600 leading-relaxed mb-8">
                      {service.description}
                    </p>
                    <ul class="space-y-4">
                      {service.items.map((item) => (
                        <li class="flex gap-3">
                          <svg class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                          <span class="text-slate-600 text-sm leading-relaxed">{item.label}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </ScrollReveal>
              </>
            ) : (
              <>
                <ScrollReveal direction={contentDirection} delay={200}>
                  <div>
                    <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
                      {service.subtitle}
                    </span>
                    <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
                      {service.title}
                    </h2>
                    <div class="section-line mb-6" />
                    <p class="text-slate-600 leading-relaxed mb-8">
                      {service.description}
                    </p>
                    <ul class="space-y-4">
                      {service.items.map((item) => (
                        <li class="flex gap-3">
                          <svg class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                          <span class="text-slate-600 text-sm leading-relaxed">{item.label}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </ScrollReveal>
                <ScrollReveal direction={imageDirection} delay={100}>
                  <div class="relative">
                    <div class="rounded-2xl overflow-hidden shadow-xl">
                      <img
                        src={service.image}
                        alt={service.imageAlt}
                        class="w-full h-[400px] object-cover rounded-2xl shadow-xl"
                       loading="lazy"/>
                    </div>
                  </div>
                </ScrollReveal>
              </>
            )}
          </div>
        </div>
      </section>
    );
  })}

  {/* ===== PROCESS WORKFLOW ===== */}
  <section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Nuestro flujo de trabajo
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              Del envío al pago
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              Cada reclamo pasa por un flujo de trabajo probado de tres etapas.
              Nuestro equipo asegura que cada paso se complete con precisión,
              rapidez y total transparencia.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-sm">1</div>
                <div>
                  <strong class="text-navy-900">Enviar</strong>
                  <p class="text-sm text-slate-600">Reclamos validados y enviados en menos de 24 horas</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-sm">2</div>
                <div>
                  <strong class="text-navy-900">Procesar</strong>
                  <p class="text-sm text-slate-600">Procesamiento electrónico con todos los pagadores, seguimiento en tiempo real</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-sm">3</div>
                <div>
                  <strong class="text-navy-900">Pagado</strong>
                  <p class="text-sm text-slate-600">Pagos registrados, denegaciones resueltas, depósitos conciliados</p>
                </div>
              </li>
            </ul>
          </div>
        </ScrollReveal>
        <ScrollReveal direction="right">
          <img
            src="/illustrations/workflow.svg"
            alt="Flujo de reclamos desde el envío hasta el pago"
            class="w-full h-auto rounded-2xl"
           loading="lazy"/>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== TECHNOLOGY & EMR INTEGRATIONS ===== */}
  <section class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mb-4">
            Experiencia en los principales EMR
          </h2>
          <div class="section-line mx-auto mb-6" />
          <p class="text-slate-600 text-lg max-w-2xl mx-auto leading-relaxed">
            Nuestro equipo está capacitado en todos los principales EMR y
            plataformas de facturación. Trabajamos dentro de su sistema
            existente &mdash; sin necesidad de integración técnica.
          </p>
        </div>
      </ScrollReveal>

      <ScrollReveal delay={100}>
        <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-4 mb-12">
          {emrs.map((emr) => (
            <div class="bg-cream rounded-xl p-6 text-center">
              <span class="font-semibold text-navy-900">{emr}</span>
            </div>
          ))}
        </div>
      </ScrollReveal>

      <ScrollReveal delay={200}>
        <p class="text-center text-slate-600 leading-relaxed">
          ¿No ve su sistema? Nos integramos con la mayoría de las plataformas
          de software de salud.{' '}
          <a
            href="/es/contact"
            class="text-teal-600 font-semibold underline underline-offset-2 hover:text-teal-700 transition-colors"
          >
            Contáctenos para confirmar la compatibilidad.
          </a>
        </p>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== ONBOARDING PROCESS ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mb-4">
            Qué esperar en sus primeros 30 días
          </h2>
          <div class="section-line mx-auto mb-6" />
        </div>
      </ScrollReveal>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {onboardingSteps.map((item, idx) => (
          <ScrollReveal delay={idx * 100}>
            <div class="bg-white rounded-2xl p-6 h-full">
              <div class="w-10 h-10 rounded-full bg-teal-600 text-white flex items-center justify-center font-bold text-lg mb-4">
                {item.step}
              </div>
              <h3 class="font-serif text-xl text-navy-900 mb-3">
                {item.title}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  {/* ===== REPORTING DASHBOARD ===== */}
  <section class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left" delay={100}>
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <img
              src="/images/financial-report.jpg"
              alt="Panel de informes financieros"
              class="w-full h-[400px] object-cover rounded-2xl shadow-xl"
             loading="lazy"/>
          </div>
        </ScrollReveal>

        <ScrollReveal direction="right" delay={200}>
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Informes transparentes
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
              Visibilidad financiera en tiempo real
            </h2>
            <div class="section-line mb-6" />
            <p class="text-slate-600 leading-relaxed mb-8">
              Manténgase informado con informes detallados y transparentes que
              le dan visibilidad total de su ciclo de ingresos. Nuestro panel
              e informes mensuales aseguran que siempre sepa dónde está su
              dinero y qué se está haciendo para cobrarlo.
            </p>
            <ul class="space-y-4">
              {reportingFeatures.map((feature) => (
                <li class="flex gap-3">
                  <svg class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span class="text-slate-600 text-sm leading-relaxed">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== CODING EXPERTISE ===== */}
  <section class="bg-cream py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mb-4">
            Especialistas en codificación certificados
          </h2>
          <div class="section-line mx-auto mb-6" />
          <p class="text-slate-600 text-lg max-w-3xl mx-auto leading-relaxed">
            Nuestros codificadores cuentan con certificaciones estándar de la
            industria y se mantienen actualizados sobre todos los cambios
            regulatorios.
          </p>
        </div>
      </ScrollReveal>

      <div class="grid md:grid-cols-3 gap-6">
        {codingItems.map((item, idx) => (
          <ScrollReveal delay={idx * 100}>
            <div class="bg-white rounded-xl p-6 h-full">
              <svg class="w-10 h-10 text-teal-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
              <h3 class="font-serif text-xl text-navy-900 mb-3">
                {item.title}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          ¿Listo para optimizar su facturación?
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Permita que nuestro equipo experto maneje las complejidades de la
          facturación médica para que usted pueda concentrarse en lo que más
          importa &mdash; sus pacientes.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/es/contact" class="btn-primary">
            <span>Comience hoy</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/es/contact" class="btn-outline">
            Contáctenos
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
