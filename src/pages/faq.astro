---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

const faqs = [
  {
    question: "What medical billing services does CPS offer?",
    answer:
      "CPS provides comprehensive revenue cycle management including claims submission, payment posting, denial management, accounts receivable follow-up, eligibility verification, payer enrollment, credentialing, and detailed monthly reporting. We specialize in hospice, home health, and palliative care billing.",
  },
  {
    question: "How does outsourcing billing to CPS work?",
    answer:
      "The process is straightforward. We start with a free assessment of your current billing operations. Once onboarded, our team integrates with your EMR system, takes over claims submission and follow-up, and provides you with regular financial reports. You maintain full visibility through our reporting dashboard.",
  },
  {
    question: "What EMR systems do you integrate with?",
    answer:
      "We work with all major healthcare EMR systems including Axxess, HCHB (Homecare Homebase), MatrixCare, Brightree, KanTime, Netsmart, WellSky, and many others. If you use a system not listed, contact us — we can likely integrate with it.",
  },
  {
    question: "How long does the onboarding process take?",
    answer:
      "Typical onboarding takes 2-4 weeks. This includes EMR access setup, historical data review, payer enrollment verification, and staff training on our workflow. We handle the heavy lifting so the transition is seamless for your team.",
  },
  {
    question: "Do you require long-term contracts?",
    answer:
      "No. We offer flexible month-to-month agreements. We believe our results should earn your continued partnership, not a contract. Most of our clients stay with us because of the value we deliver, not because they are locked in.",
  },
  {
    question: "How do you handle denied claims?",
    answer:
      "We have a structured 5-step denial management process: immediate identification, root cause analysis, corrective action, timely resubmission or appeal, and prevention. Our process recovers an average of 65% of initially denied claims.",
  },
  {
    question: "What reports will I receive?",
    answer:
      "You will receive comprehensive monthly reports including collections summary, A/R aging analysis, denial rates and trends, payer mix breakdown, and revenue projections. We also provide real-time access to key metrics through our reporting dashboard.",
  },
  {
    question: "Is my patient data secure with CPS?",
    answer:
      "Absolutely. We are fully HIPAA compliant and follow strict data security protocols. All data is encrypted in transit and at rest. We execute Business Associate Agreements (BAAs) with all clients and conduct regular security audits.",
  },
  {
    question: "What is your pricing model?",
    answer:
      "We offer transparent percentage-based pricing typically ranging from 4-8% of collections, depending on your practice size and specialty. There are no hidden fees or setup charges. You only pay when we collect. Visit our pricing page for detailed tier information.",
  },
  {
    question: "How do I get started with CPS?",
    answer:
      "Getting started is easy. Request a free billing assessment through our website or call us at 801-341-9304. Our team will review your current billing operations, identify opportunities for improvement, and provide a customized proposal. There is no cost or obligation.",
  },
  {
    question:
      "Can you work with small practices or do you only serve large agencies?",
    answer:
      "We work with practices of all sizes, from solo practitioners to large multi-facility agencies. Our pricing scales with your volume, so smaller practices get the same quality service at an appropriate cost. We actually specialize in helping small-to-mid-size agencies punch above their weight with enterprise-level billing operations.",
  },
  {
    question: "What happens if we switch billing companies mid-year?",
    answer:
      "Transitioning billing companies is easier than most agencies realize. We manage the transition for you, including historical claim cleanup, EMR access setup, and payer re-enrollment where needed. Most clients are fully transitioned within 2-4 weeks with zero revenue disruption. We also handle any orphaned claims from your previous billing company.",
  },
  {
    question: "Do you help with payer credentialing and enrollment?",
    answer:
      "Yes. Payer credentialing and enrollment are standard services we provide to all clients. This includes initial enrollment with Medicare, Medicaid, and commercial payers, CAQH profile management, re-credentialing cycles, and adding new physicians or services to existing enrollments. Proper credentialing is the foundation of clean billing.",
  },
  {
    question:
      "How do you handle compliance with OIG and CMS regulations?",
    answer:
      "Compliance is integrated into every aspect of our service. We maintain current knowledge of OIG guidance, CMS regulatory updates, and state-specific requirements. Our compliance program includes monthly internal audits, staff certification requirements, documented policies and procedures, and prompt investigation of any potential issues. We provide quarterly compliance updates to clients.",
  },
  {
    question: "What types of reports do you provide?",
    answer:
      "Our standard reporting suite includes: Daily claim submission and acceptance reports, Weekly A/R aging and denial tracking, Monthly comprehensive financial performance with trending, Quarterly strategic reviews with benchmarking, and Real-time dashboard access for all key metrics. We also provide custom reports on request for specific operational needs or board presentations.",
  },
  {
    question:
      "Do you work with commercial payers and Managed Medicare/Medicaid plans?",
    answer:
      "Yes. We handle all payer types including traditional Medicare, Medicare Advantage plans, traditional Medicaid, Medicaid managed care organizations, commercial insurance (Blue Cross, United, Aetna, Cigna, Humana, etc.), TRICARE, workers compensation, and private pay. Each payer has specific rules and our team stays current on all of them.",
  },
  {
    question:
      "How quickly can we expect to see results after partnering with CPS?",
    answer:
      "Most clients see measurable improvements within the first 30-60 days, including faster claim submission, reduced denial rates, and better cash flow. Full revenue cycle optimization typically takes 90-120 days as we complete historical cleanup and implement all improvements. Within 12 months, our clients typically see 15-25% revenue increases compared to their prior billing operations.",
  },
  {
    question:
      "What if we're currently in a contract with another billing company?",
    answer:
      "We've helped many clients navigate contract transitions. We can review your current contract for termination clauses and help you plan a compliant exit. We can also run parallel operations for a transition period if your contract requires notice. Contact us to discuss your specific situation.",
  },
];

const categories = [
  {
    title: "Services & Scope",
    desc: "Learn what we offer, how we work, and what's included in our services",
    icon: "M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z",
  },
  {
    title: "Pricing & Contracts",
    desc: "Understand our pricing model, contract terms, and what to expect financially",
    icon: "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Security & Compliance",
    desc: "Find out about our HIPAA compliance, data security, and audit practices",
    icon: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---
<BaseLayout
  title="Frequently Asked Questions"
  description="Find answers to common questions about CPS Medical Billing services, pricing, onboarding, and more."
>
  {/* ===== JSON-LD STRUCTURED DATA ===== */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/online-consultation.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <ScrollReveal>
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
            Got Questions?
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
            Frequently Asked Questions
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
            Everything you need to know about our medical billing services
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== FAQ INTRO WITH ILLUSTRATION ===== */}
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">
        {categories.map((cat) => (
          <div class="bg-cream rounded-2xl p-6 border border-slate-100 text-center hover:shadow-lg transition-shadow">
            <div class="inline-flex w-14 h-14 rounded-xl bg-gradient-to-br from-teal-500 to-teal-700 items-center justify-center mb-4">
              <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={cat.icon} />
              </svg>
            </div>
            <h3 class="font-serif text-lg text-navy-900 mb-2">{cat.title}</h3>
            <p class="text-slate-600 text-sm">{cat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== FAQ ACCORDION ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <ScrollReveal direction="stagger">
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none font-semibold text-navy-900 hover:text-teal-600 transition-colors">
                <span>{faq.question}</span>
                <svg
                  class="w-5 h-5 text-slate-400 flex-shrink-0 ml-4 group-open:rotate-180 transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-slate-600 text-sm leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== STILL HAVE QUESTIONS ===== */}
  <section class="bg-white py-16">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mb-3">
          Still Have Questions?
        </h2>
        <div class="section-line mx-auto mb-10" />
      </ScrollReveal>
      <ScrollReveal direction="stagger">
        <div class="grid md:grid-cols-2 gap-8">
          {/* Call Us */}
          <div class="bg-cream rounded-xl p-6 text-center card-hover">
            <div class="flex justify-center mb-4">
              <div class="w-12 h-12 rounded-full bg-teal-50 flex items-center justify-center">
                <svg
                  class="w-6 h-6 text-teal-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                  />
                </svg>
              </div>
            </div>
            <h3 class="font-serif text-xl text-navy-900 mb-2">
              Call Us
            </h3>
            <a
              href="tel:801-341-9304"
              class="text-teal-600 font-semibold text-lg hover:text-teal-700 transition-colors"
            >
              801-341-9304
            </a>
            <p class="text-slate-600 text-sm mt-2">
              Mon&ndash;Sat, 10AM&ndash;6PM
            </p>
          </div>

          {/* Email Us */}
          <div class="bg-cream rounded-xl p-6 text-center card-hover">
            <div class="flex justify-center mb-4">
              <div class="w-12 h-12 rounded-full bg-teal-50 flex items-center justify-center">
                <svg
                  class="w-6 h-6 text-teal-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  />
                </svg>
              </div>
            </div>
            <h3 class="font-serif text-xl text-navy-900 mb-2">
              Email Us
            </h3>
            <a
              href="mailto:completeprosolns@gmail.com"
              class="text-teal-600 font-semibold hover:text-teal-700 transition-colors break-all"
            >
              completeprosolns@gmail.com
            </a>
            <p class="text-slate-600 text-sm mt-2">
              Response within 24 hours
            </p>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          Ready to Get Started?
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Let our experts handle your billing so you can focus on your
          patients.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/assessment" class="btn-primary">
            <span>Free Assessment</span>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a
            href="/pricing"
            class="btn-outline-dark text-white border-white hover:bg-white hover:text-navy-900"
          >
            View Pricing
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
