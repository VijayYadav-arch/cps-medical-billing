---
import BaseLayout from '@/layouts/BaseLayout.astro';

const integrations = [
  {
    name: "Axxess EMR",
    description: "Sync patients, encounters, and claims with Axxess home health and hospice EMR.",
    category: "EMR",
    status: "available" as const,
    logo: "AX",
    color: "bg-teal-100 text-teal-700",
  },
  {
    name: "HCHB",
    description: "Connect with Homecare Homebase for enterprise home health and hospice data exchange.",
    category: "EMR",
    status: "coming-soon" as const,
    logo: "HB",
    color: "bg-blue-100 text-blue-700",
  },
  {
    name: "Change Healthcare",
    description: "Submit claims, check eligibility, and receive remittance through Change Healthcare clearinghouse.",
    category: "Clearinghouse",
    status: "available" as const,
    logo: "CH",
    color: "bg-green-100 text-green-700",
  },
  {
    name: "Availity",
    description: "Multi-payer gateway for claims submission, eligibility verification, and prior authorization.",
    category: "Clearinghouse",
    status: "available" as const,
    logo: "AV",
    color: "bg-purple-100 text-purple-700",
  },
  {
    name: "Ability Network",
    description: "Most popular clearinghouse for post-acute care, especially hospice 837I institutional claims.",
    category: "Clearinghouse",
    status: "available" as const,
    logo: "AN",
    color: "bg-orange-100 text-orange-700",
  },
  {
    name: "Waystar",
    description: "Claims management, remittance, and denial management for mid-size home health and hospice agencies.",
    category: "Clearinghouse",
    status: "available" as const,
    logo: "WS",
    color: "bg-indigo-100 text-indigo-700",
  },
  {
    name: "Office Ally",
    description: "Free and low-cost clearinghouse for small practices with 837P and 837I claim submission support.",
    category: "Clearinghouse",
    status: "available" as const,
    logo: "OA",
    color: "bg-rose-100 text-rose-700",
  },
  {
    name: "QuickBooks",
    description: "Sync billing and payment data with QuickBooks for streamlined accounting.",
    category: "Accounting",
    status: "coming-soon" as const,
    logo: "QB",
    color: "bg-emerald-100 text-emerald-700",
  },
  {
    name: "Salesforce CRM",
    description: "Integrate patient referrals and organization management with Salesforce.",
    category: "CRM",
    status: "coming-soon" as const,
    logo: "SF",
    color: "bg-sky-100 text-sky-700",
  },
];
---
<BaseLayout
  title="Integration Marketplace | CPS Medical Billing"
  isDefaultTitle={true}
  description="Connect CPS with your EMR, clearinghouse, accounting, and CRM systems."
>
  <div class="min-h-screen bg-gradient-to-b from-navy-900 to-navy-800">
    {/* Hero */}
    <section class="relative py-20 px-4">
      <div class="max-w-5xl mx-auto text-center">
        <span class="inline-block text-teal-400 text-sm font-semibold uppercase tracking-wider mb-4">
          Integrations
        </span>
        <h1 class="font-serif text-4xl md:text-5xl text-white mb-4">
          Integration Marketplace
        </h1>
        <p class="text-slate-300 text-lg max-w-2xl mx-auto">
          Connect CPS Medical Billing with your EMR, clearinghouse, accounting, and CRM systems.
          Streamline your workflow with one-click integrations.
        </p>
      </div>
    </section>

    {/* Integration Grid */}
    <section class="pb-20 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {integrations.map((integration) => (
            <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6 flex flex-col">
              {/* Logo and Badge */}
              <div class="flex items-start justify-between mb-4">
                <div class={`w-14 h-14 rounded-xl ${integration.color} flex items-center justify-center font-bold text-lg`}>
                  {integration.logo}
                </div>
                <span class={`inline-flex px-2.5 py-1 rounded-full text-xs font-semibold ${
                  integration.status === "available"
                    ? "bg-green-50 text-green-700 border border-green-200"
                    : "bg-slate-100 text-slate-600 border border-slate-200"
                }`}>
                  {integration.status === "available" ? "Available" : "Coming Soon"}
                </span>
              </div>

              {/* Content */}
              <h3 class="font-semibold text-lg text-navy-900 mb-1">
                {integration.name}
              </h3>
              <p class="text-sm text-slate-500 mb-1">
                {integration.category}
              </p>
              <p class="text-sm text-slate-600 flex-1 mb-4">
                {integration.description}
              </p>

              {/* Action Button */}
              {integration.status === "available" ? (
                <button class="w-full py-2.5 px-4 bg-teal-600 text-white text-sm font-semibold rounded-lg hover:bg-teal-700 transition-colors">
                  Connect
                </button>
              ) : (
                <button
                  disabled
                  class="w-full py-2.5 px-4 bg-slate-100 text-slate-500 text-sm font-semibold rounded-lg cursor-not-allowed"
                >
                  Coming Soon
                </button>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
