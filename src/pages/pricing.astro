---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

/* ---- Pricing tier data ---- */
const starterFeatures = [
  "Claims submission & follow-up",
  "Payment posting",
  "Monthly reporting",
  "Denial management",
  "Eligibility verification",
  "Email support",
];

const professionalFeatures = [
  "Everything in Starter",
  "Dedicated account manager",
  "Weekly A/R review calls",
  "Payer enrollment & credentialing",
  "Custom financial dashboards",
  "Priority phone support",
];

const enterpriseFeatures = [
  "Everything in Professional",
  "Multiple facility support",
  "Compliance consulting",
  "Revenue cycle optimization",
  "Executive reporting suite",
  "24/7 dedicated support",
];

const inclusions = [
  "Dedicated account manager",
  "Weekly performance reviews",
  "Real-time reporting portal",
  "24-hour response SLA",
  "No long-term contracts",
  "Free onboarding support",
];

/* ---- FAQ data ---- */
const faqs = [
  {
    question: "Are there setup fees?",
    answer:
      "We offer complimentary onboarding for all new clients. There are no hidden setup fees or activation charges.",
  },
  {
    question: "What's included in the percentage?",
    answer:
      "Our fee covers the complete revenue cycle: claims submission, payment posting, denial management, follow-up, and monthly reporting.",
  },
  {
    question: "Do you require long-term contracts?",
    answer:
      "No. We offer month-to-month agreements because we believe our results should earn your business, not a contract.",
  },
  {
    question: "How is the percentage calculated?",
    answer:
      "Our fee is based on actual collections received, not charges submitted. You only pay when we collect.",
  },
];
---
<BaseLayout
  title="Pricing"
  description="Transparent pricing for medical billing services. Choose from flexible plans designed for practices of all sizes."
>
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/billing-paperwork.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <ScrollReveal>
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
            Simple, Transparent Pricing
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
            Pricing That Works for Your Practice
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
            No hidden fees. No long-term contracts required. Just results.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== PRICING CARDS ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal direction="stagger">
        <div class="grid md:grid-cols-3 gap-8 items-start">

          {/* --- Starter --- */}
          <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm">
            <span class="inline-block text-xs font-semibold uppercase tracking-wider text-teal-600 bg-teal-50 px-3 py-1 rounded-full mb-4">
              Small Practices
            </span>
            <h2 class="font-serif text-2xl text-navy-900 mb-4">
              Starter
            </h2>
            <div class="mb-2">
              <span class="font-serif text-5xl font-bold text-navy-900">
                6&ndash;8%
              </span>
            </div>
            <p class="text-sm text-slate-600 mb-4">of collections</p>
            <p class="text-slate-600 text-sm leading-relaxed mb-8">
              For practices with fewer than 50 patients
            </p>
            <ul class="space-y-3 mb-10">
              {starterFeatures.map((feature) => (
                <li class="flex gap-3">
                  <svg
                    class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  <span class="text-slate-600 text-sm leading-relaxed">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
            <a href="/assessment" class="btn-outline-dark w-full text-center">
              Get Started
            </a>
          </div>

          {/* --- Professional (highlighted) --- */}
          <div class="bg-white rounded-2xl p-8 border-2 border-teal-600 shadow-lg relative">
            <span class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-teal-600 text-white rounded-full px-4 py-1 text-xs font-semibold whitespace-nowrap">
              Most Popular
            </span>
            <span class="inline-block text-xs font-semibold uppercase tracking-wider text-teal-600 bg-teal-50 px-3 py-1 rounded-full mb-4">
              Mid-Size Agencies
            </span>
            <h2 class="font-serif text-2xl text-navy-900 mb-4">
              Professional
            </h2>
            <div class="mb-2">
              <span class="font-serif text-5xl font-bold text-navy-900">
                5&ndash;7%
              </span>
            </div>
            <p class="text-sm text-slate-600 mb-4">of collections</p>
            <p class="text-slate-600 text-sm leading-relaxed mb-8">
              For agencies with 50&ndash;200 patients
            </p>
            <ul class="space-y-3 mb-10">
              {professionalFeatures.map((feature) => (
                <li class="flex gap-3">
                  <svg
                    class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  <span class="text-slate-600 text-sm leading-relaxed">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
            <a href="/assessment" class="btn-primary w-full text-center justify-center">
              Get Started
            </a>
          </div>

          {/* --- Enterprise --- */}
          <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm">
            <span class="inline-block text-xs font-semibold uppercase tracking-wider text-teal-600 bg-teal-50 px-3 py-1 rounded-full mb-4">
              Large Organizations
            </span>
            <h2 class="font-serif text-2xl text-navy-900 mb-4">
              Enterprise
            </h2>
            <div class="mb-2">
              <span class="font-serif text-5xl font-bold text-navy-900">
                Custom
              </span>
            </div>
            <p class="text-sm text-slate-600 mb-4">
              tailored to your needs
            </p>
            <p class="text-slate-600 text-sm leading-relaxed mb-8">
              For organizations with 200+ patients
            </p>
            <ul class="space-y-3 mb-10">
              {enterpriseFeatures.map((feature) => (
                <li class="flex gap-3">
                  <svg
                    class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  <span class="text-slate-600 text-sm leading-relaxed">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn-outline-dark w-full text-center">
              Contact Us
            </a>
          </div>

        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== VALUE & TRUST ===== */}
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <img
            src="/illustrations/team-collaboration.svg"
            alt="Partnership and team collaboration"
            class="w-full h-auto rounded-2xl"
           loading="lazy"/>
        </ScrollReveal>
        <ScrollReveal direction="right">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              More Than Pricing
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              Every Plan Includes Premium Service
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              No matter which tier you choose, you get the same quality service
              that has earned us a 95% client retention rate. Our team becomes an
              extension of yours.
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              {inclusions.map((item) => (
                <div class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span class="text-sm text-slate-600">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== FAQ SECTION ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
            Have Questions?
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
            Common Pricing Questions
          </h2>
          <div class="section-line mx-auto" />
        </div>
      </ScrollReveal>

      <ScrollReveal direction="stagger">
        <div class="grid sm:grid-cols-2 gap-6">
          {faqs.map((faq) => (
            <div class="bg-cream rounded-xl p-6">
              <h3 class="font-semibold text-navy-900 mb-3">
                {faq.question}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== CTA SECTION ===== */}
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          Not Sure Which Plan Is Right?
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Request a free assessment and we&apos;ll recommend the best plan
          for your practice.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/assessment" data-track-cta="assessment" data-cta-source="pricing" class="btn-primary">
            <span>Get Free Assessment</span>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a
            href="tel:801-341-9304"
            class="btn-outline-dark text-white border-white hover:bg-white hover:text-navy-900"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
              />
            </svg>
            <span>Call 801-341-9304</span>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
