---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

/* ---- Service section data ---- */
interface ServiceItem {
  label: string;
}

interface ServiceSection {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  image: string;
  imageAlt: string;
  items: ServiceItem[];
  imageFirst: boolean;
}

const services: ServiceSection[] = [
  {
    id: "hospice",
    title: "Hospice Billing Services",
    subtitle: "Comprehensive End-of-Life Care Billing",
    description:
      "Our hospice billing team ensures accurate, timely claim submission across all payer types. We manage the entire revenue cycle so your team can focus on delivering compassionate care.",
    image: "/images/hospice-care.jpg",
    imageAlt: "Hospice care professionals with patients",
    items: [
      { label: "Billing all payers including Medicare, Medicaid, and commercial insurance" },
      { label: "Claims processing including NOE, NOTR, and monthly claim filing" },
      { label: "Payment posting and remittance review" },
      { label: "Accounts receivable management and follow-up" },
      { label: "Daily and monthly reporting with revenue projections" },
      { label: "Eligibility verification and benefit checks" },
      { label: "EDI and EFT enrollment and setup" },
      { label: "Payer enrollment and software configuration" },
    ],
    imageFirst: true,
  },
  {
    id: "home-health",
    title: "Home Health Billing Services",
    subtitle: "Streamlined Home Health Revenue Cycle",
    description:
      "We provide end-to-end billing support for home health agencies, ensuring clean claims and maximized reimbursements from day one.",
    image: "/images/home-health.jpg",
    imageAlt: "Home health caregiver with patient",
    items: [
      { label: "Daily NOA submissions and claims processing" },
      { label: "A/R analysis, follow-up, and denial management" },
      { label: "Monthly financial and operational reporting" },
      { label: "Complimentary credentialing and payer support services" },
    ],
    imageFirst: false,
  },
  {
    id: "palliative",
    title: "Palliative Care Billing Services",
    subtitle: "Specialized Palliative Care Revenue Management",
    description:
      "Our team understands the unique coding and billing requirements for palliative care, helping your practice capture every dollar earned.",
    image: "/images/palliative-care.jpg",
    imageAlt: "Palliative care doctor with patient",
    items: [
      { label: "Daily claims submissions across all payer types" },
      { label: "Monthly reporting with detailed revenue analysis" },
      { label: "Accounts receivable management and collections follow-up" },
    ],
    imageFirst: true,
  },
];

const emrs = [
  "Axxess",
  "HCHB (Homecare Homebase)",
  "MatrixCare",
  "Brightree",
  "KanTime",
  "Netsmart",
  "WellSky",
  "Kinnser",
  "PointClickCare",
  "Thornberry",
];

const onboardingSteps = [
  {
    step: 1,
    title: "Week 1: Discovery",
    description:
      "We review your current billing operations, EMR setup, and payer relationships to understand the full picture before making any changes.",
  },
  {
    step: 2,
    title: "Week 2: Setup",
    description:
      "EMR access, payer enrollment verification, team introductions, and workflow design tailored to your agency’s needs.",
  },
  {
    step: 3,
    title: "Week 3: Transition",
    description:
      "Gradual takeover of active claims, historical cleanup, and thorough process testing to ensure nothing falls through the cracks.",
  },
  {
    step: 4,
    title: "Week 4+: Full Service",
    description:
      "Complete billing operations, daily submissions, monthly reporting, and ongoing optimization of your revenue cycle.",
  },
];

const reportingFeatures = [
  "Real-time A/R aging by payer",
  "Daily collection deposits and trends",
  "Denial rate tracking and analysis",
  "Payer mix and reimbursement analysis",
  "Claims submission and rejection tracking",
  "Monthly financial performance summaries",
];

const codingItems = [
  {
    title: "ICD-10-CM/PCS",
    description:
      "Expert coding for all diagnosis and procedure codes specific to hospice, home health, and palliative care.",
  },
  {
    title: "CPT & HCPCS",
    description:
      "Accurate procedure coding for all billable services, including E/M, care management, and advance care planning codes.",
  },
  {
    title: "Revenue Codes",
    description:
      "Proper revenue code assignment for all facility-based services across Medicare, Medicaid, and commercial payers.",
  },
];
---
<BaseLayout title="Services">
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/hero-healthcare.jpg" />
    <div class="hero-pattern" />
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <ScrollReveal>
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
            What We Offer
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
            Our Services
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed mb-10 max-w-2xl mx-auto">
            Empowering Healthcare, Elevating Revenue: CPS Your Partner in
            Seamless Medical Billing Solutions
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="tel:801-341-9304" class="btn-primary">
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                />
              </svg>
              <span>Call Us</span>
            </a>
            <a href="/contact" class="btn-outline">
              Leave a Message
            </a>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== SERVICE SECTIONS ===== */}
  {services.map((service, index) => {
    const bgClass = index % 2 === 0 ? "bg-white" : "bg-cream";
    const imageDirection = service.imageFirst ? "left" : "right";
    const contentDirection = service.imageFirst ? "right" : "left";

    return (
      <section class={`py-24 ${bgClass}`}>
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <div class="grid lg:grid-cols-2 gap-16 items-center">
            {service.imageFirst ? (
              <>
                <ScrollReveal direction={imageDirection} delay={100}>
                  <div class="relative">
                    <div class="rounded-2xl overflow-hidden shadow-xl">
                      <img
                        src={service.image}
                        alt={service.imageAlt}
                        class="w-full h-[400px] object-cover rounded-2xl shadow-xl"
                       loading="lazy"/>
                    </div>
                  </div>
                </ScrollReveal>
                <ScrollReveal direction={contentDirection} delay={200}>
                  <div>
                    <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
                      {service.subtitle}
                    </span>
                    <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
                      {service.title}
                    </h2>
                    <div class="section-line mb-6" />
                    <p class="text-slate-600 leading-relaxed mb-8">
                      {service.description}
                    </p>
                    <ul class="space-y-4">
                      {service.items.map((item) => (
                        <li class="flex gap-3">
                          <svg
                            class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4.5 12.75l6 6 9-13.5"
                            />
                          </svg>
                          <span class="text-slate-600 text-sm leading-relaxed">
                            {item.label}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </ScrollReveal>
              </>
            ) : (
              <>
                <ScrollReveal direction={contentDirection} delay={200}>
                  <div>
                    <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
                      {service.subtitle}
                    </span>
                    <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
                      {service.title}
                    </h2>
                    <div class="section-line mb-6" />
                    <p class="text-slate-600 leading-relaxed mb-8">
                      {service.description}
                    </p>
                    <ul class="space-y-4">
                      {service.items.map((item) => (
                        <li class="flex gap-3">
                          <svg
                            class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4.5 12.75l6 6 9-13.5"
                            />
                          </svg>
                          <span class="text-slate-600 text-sm leading-relaxed">
                            {item.label}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </ScrollReveal>
                <ScrollReveal direction={imageDirection} delay={100}>
                  <div class="relative">
                    <div class="rounded-2xl overflow-hidden shadow-xl">
                      <img
                        src={service.image}
                        alt={service.imageAlt}
                        class="w-full h-[400px] object-cover rounded-2xl shadow-xl"
                       loading="lazy"/>
                    </div>
                  </div>
                </ScrollReveal>
              </>
            )}
          </div>
        </div>
      </section>
    );
  })}

  {/* ===== PROCESS WORKFLOW ===== */}
  <section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Our Workflow
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              From Submission to Payment
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              Every claim moves through a proven three-stage workflow. Our team
              ensures each step is completed with precision, speed, and full
              transparency.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-sm">1</div>
                <div>
                  <strong class="text-navy-900">Submit</strong>
                  <p class="text-sm text-slate-600">Claims validated and submitted within 24 hours</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-sm">2</div>
                <div>
                  <strong class="text-navy-900">Process</strong>
                  <p class="text-sm text-slate-600">Electronic processing with all payers, real-time tracking</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-sm">3</div>
                <div>
                  <strong class="text-navy-900">Paid</strong>
                  <p class="text-sm text-slate-600">Payments posted, denials resolved, deposits reconciled</p>
                </div>
              </li>
            </ul>
          </div>
        </ScrollReveal>
        <ScrollReveal direction="right">
          <img
            src="/illustrations/workflow.svg"
            alt="Claims workflow from submission to payment"
            class="w-full h-auto rounded-2xl"
           loading="lazy"/>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== TECHNOLOGY & EMR INTEGRATIONS ===== */}
  <section class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mb-4">
            Experienced Across All Major EMRs
          </h2>
          <div class="section-line mx-auto mb-6" />
          <p class="text-slate-600 text-lg max-w-2xl mx-auto leading-relaxed">
            Our team is trained on every major healthcare EMR and billing platform.
            We work within your existing system &mdash; no technical integration required.
          </p>
        </div>
      </ScrollReveal>

      <ScrollReveal delay={100}>
        <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-4 mb-12">
          {emrs.map((emr) => (
            <div class="bg-cream rounded-xl p-6 text-center">
              <span class="font-semibold text-navy-900">{emr}</span>
            </div>
          ))}
        </div>
      </ScrollReveal>

      <ScrollReveal delay={200}>
        <p class="text-center text-slate-600 leading-relaxed">
          Don&rsquo;t see your system? We integrate with most healthcare
          software platforms.{' '}
          <a
            href="/contact"
            class="text-teal-600 font-semibold underline underline-offset-2 hover:text-teal-700 transition-colors"
          >
            Contact us to confirm compatibility.
          </a>
        </p>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== ONBOARDING PROCESS ===== */}
  <section class="bg-cream py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mb-4">
            What to Expect in Your First 30 Days
          </h2>
          <div class="section-line mx-auto mb-6" />
        </div>
      </ScrollReveal>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {onboardingSteps.map((item, idx) => (
          <ScrollReveal delay={idx * 100}>
            <div class="bg-white rounded-2xl p-6 h-full">
              <div class="w-10 h-10 rounded-full bg-teal-600 text-white flex items-center justify-center font-bold text-lg mb-4">
                {item.step}
              </div>
              <h3 class="font-serif text-xl text-navy-900 mb-3">
                {item.title}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  {/* ===== REPORTING DASHBOARD ===== */}
  <section class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left" delay={100}>
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <img
              src="/images/financial-report.jpg"
              alt="Financial reporting dashboard"
              class="w-full h-[400px] object-cover rounded-2xl shadow-xl"
             loading="lazy"/>
          </div>
        </ScrollReveal>

        <ScrollReveal direction="right" delay={200}>
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Transparent Reporting
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-4">
              Real-Time Financial Visibility
            </h2>
            <div class="section-line mb-6" />
            <p class="text-slate-600 leading-relaxed mb-8">
              Stay informed with detailed, transparent reporting that gives
              you complete visibility into your revenue cycle. Our dashboard
              and monthly reports ensure you always know where your money is
              and what&rsquo;s being done to collect it.
            </p>
            <ul class="space-y-4">
              {reportingFeatures.map((feature) => (
                <li class="flex gap-3">
                  <svg
                    class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  <span class="text-slate-600 text-sm leading-relaxed">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== CODING EXPERTISE ===== */}
  <section class="bg-cream py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mb-4">
            Certified Coding Specialists
          </h2>
          <div class="section-line mx-auto mb-6" />
          <p class="text-slate-600 text-lg max-w-3xl mx-auto leading-relaxed">
            Our coders hold industry-standard certifications and stay current
            on all regulatory changes
          </p>
        </div>
      </ScrollReveal>

      <div class="grid md:grid-cols-3 gap-6">
        {codingItems.map((item, idx) => (
          <ScrollReveal delay={idx * 100}>
            <div class="bg-white rounded-xl p-6 h-full">
              <svg
                class="w-10 h-10 text-teal-600 mb-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
                />
              </svg>
              <h3 class="font-serif text-xl text-navy-900 mb-3">
                {item.title}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          Ready to Streamline Your Billing?
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Let our expert team handle the complexities of medical billing so
          you can focus on what matters most &mdash; your patients.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/contact" class="btn-primary">
            <span>Get Started Today</span>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a href="/contact" class="btn-outline">
            Contact Us
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
