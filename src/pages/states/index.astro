---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { STATES } from '@/data/states';

const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://cpshealthcarebilling.com';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'States We Serve', item: `${SITE_URL}/states/` },
  ],
};
---
<BaseLayout
  title="States We Serve"
  description="CPS Medical Billing operates across all 50 states. State-specific landing pages with local payer expertise, Medicaid program details, and regulatory notes."
  extraJsonLd={[breadcrumbJsonLd]}
>
  {/* ===== HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/financial-growth.jpg" />
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
        All 50 states
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
        States we <span class="text-teal-400">serve</span>
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
        CPS provides medical billing services for hospice, home-health, and palliative-care providers in every state. Detailed pages for our highest-volume markets are below.
      </p>
    </div>
  </section>

  {/* ===== INTRO ===== */}
  <section class="py-16 bg-cream">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <ScrollReveal>
        <p class="text-slate-600 text-lg leading-relaxed">
          Each state has its own Medicaid program, prior-auth rules, and dominant managed-care plans. CPS has billing teams that know the local payer landscape in your state &mdash; click through below to see what CPS knows about billing in your market.
        </p>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== STATE GRID ===== */}
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {STATES.map((state) => (
            <a
              href={`/states/${state.slug}`}
              class="block bg-cream rounded-2xl p-7 card-hover shadow-sm border border-slate-100 group"
            >
              <div class="flex items-start justify-between mb-4">
                <h2 class="font-serif text-xl text-navy-900 group-hover:text-teal-700 transition-colors">
                  {state.name}
                </h2>
                <span class="text-xs font-bold text-slate-400 tracking-wider">{state.abbr}</span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed mb-5 line-clamp-3">
                {state.intro}
              </p>
              <span class="inline-flex items-center gap-1.5 text-teal-600 text-sm font-semibold">
                See {state.name} details
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <p class="text-slate-500 text-sm text-center mt-12 max-w-2xl mx-auto">
          Your state not listed? We serve all 50 states. <a href="/contact" class="text-teal-600 hover:text-teal-700 underline underline-offset-2 font-medium">Get in touch</a> and we will spin up the same local-payer expertise for your market.
        </p>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          Get a free assessment for your state
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Most practices we evaluate find 15&ndash;25 % in recoverable revenue. Zero cost, zero obligation.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/assessment" class="btn-primary">
            <span>Request Free Assessment</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
