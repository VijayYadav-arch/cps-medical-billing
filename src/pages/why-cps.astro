---
import RasterImage from '@/components/RasterImage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeroBackground from '@/components/PageHeroBackground.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
---
<BaseLayout title="Why CPS">
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero py-32 pt-40">
    <PageHeroBackground src="/images/financial-growth.jpg" />
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-teal-300 text-sm font-medium border border-teal-400/20 mb-6">
        Why Choose Us
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
        Why Choose <span class="text-teal-400">CPS</span>?
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Benefits Of Outsourcing Medical Billing Services
      </p>
    </div>
  </section>

  {/* ===== INTRO ===== */}
  <section class="py-20 bg-cream">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <ScrollReveal>
        <div class="text-center">
          <div class="section-line mx-auto mb-8" />
          <p class="text-slate-600 text-lg leading-relaxed">
            Outsourcing your medical billing enables healthcare providers to
            save valuable time and money while allowing them to focus on what
            matters most &mdash; delivering exceptional patient care. By
            partnering with CPS, you gain a dedicated team of billing experts
            who work tirelessly to optimize your revenue cycle, reduce claim
            denials, and accelerate reimbursements so your practice can thrive.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* ===== SECTION 1: Grow Your Revenue Daily (Image Left / Text Right) ===== */}
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <div class="relative">
            <RasterImage
              src="/images/financial-growth.jpg"
              alt="Financial growth and revenue reports"
              class="rounded-2xl shadow-xl w-full object-cover"
             loading="lazy" />
          </div>
        </ScrollReveal>

        <ScrollReveal direction="right">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Billing and Follow-up Focus
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              Grow Your Revenue Daily
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              At CPS, we take a proactive approach to medical billing that
              ensures your revenue grows consistently. Our team focuses on
              timely claim submission and rigorous follow-up practices,
              working every day to keep your revenue cycle moving forward.
            </p>
            <p class="text-slate-600 leading-relaxed">
              By staying on top of every claim from submission through
              payment, we eliminate the delays and bottlenecks that cost your
              practice money. Our daily billing and follow-up processes mean
              no claim goes unattended, resulting in a steady and growing
              stream of revenue for your organization.
            </p>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== SECTION 2: Collect More Money (Text Left / Image Right) ===== */}
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Comprehensive Payer Management
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              Collect More Money
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              CPS provides comprehensive billing across all payers &mdash;
              including Medicare, Medicaid, and private insurance carriers.
              Our team manages every aspect of the payer relationship,
              ensuring that no revenue opportunity is left on the table.
            </p>
            <p class="text-slate-600 leading-relaxed">
              When claims are denied, our denial resolution strategies go to
              work immediately. We analyze the root cause, correct any
              issues, and resubmit or appeal the claim promptly. This
              thorough approach to payer management ensures you collect the
              maximum reimbursement you deserve.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal direction="right">
          <div class="relative">
            <RasterImage
              src="/images/doctor-patient.jpg"
              alt="Healthcare professionals in comprehensive payer management"
              class="rounded-2xl shadow-xl w-full object-cover"
             loading="lazy" />
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== SECTION 3: Collect Money Faster (Image Left / Text Right) ===== */}
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <div class="relative">
            <RasterImage
              src="/images/financial-report.jpg"
              alt="Timely claim submission and financial analysis"
              class="rounded-2xl shadow-xl w-full object-cover"
             loading="lazy" />
          </div>
        </ScrollReveal>

        <ScrollReveal direction="right">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Timely Claim Submission
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              Collect Money Faster
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              Time is money in medical billing. CPS ensures prompt
              reimbursement through our expedited claim processing workflow.
              Claims are reviewed, coded, and submitted as quickly as
              possible to minimize the time between service delivery and
              payment.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Our streamlined processes and experienced billing team
              eliminate unnecessary delays, getting your claims to payers
              faster and reducing your accounts receivable days. The result
              is improved cash flow and a healthier financial position for
              your practice.
            </p>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== SECTION 4: Recovery of Previously Lost Revenue (Text Left / Image Right) ===== */}
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal direction="left">
          <div>
            <span class="text-teal-600 text-sm font-semibold uppercase tracking-wider">
              Audit-Based Recovery
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-navy-900 mt-3 mb-6">
              Recovery of Previously Lost Revenue
            </h2>
            <div class="section-line mb-8" />
            <p class="text-slate-600 leading-relaxed mb-6">
              Many healthcare providers are leaving money on the table
              without even realizing it. CPS conducts thorough audits to
              identify underpayments, overlooked claims, and outstanding
              balances that have slipped through the cracks.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Our audit-based recovery process systematically reviews your
              past billing records to uncover revenue that was previously
              lost. Whether it&apos;s underpaid claims, missed filing
              deadlines, or unresolved denials, we work to recover every
              dollar your practice is owed.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal direction="right">
          <div class="relative">
            <RasterImage
              src="/images/stethoscope.jpg"
              alt="Revenue recovery through medical billing audits"
              class="rounded-2xl shadow-xl w-full object-cover"
             loading="lazy" />
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="hero-gradient py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
      <div class="hero-pattern absolute inset-0" />
      <ScrollReveal>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mb-5 relative z-10">
          Ready to Maximize Your Revenue?
        </h2>
        <p class="text-slate-300 text-lg mb-10 relative z-10">
          Partner with CPS and experience the difference that expert medical
          billing services can make for your practice.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a href="/contact" data-track-cta="contact" data-cta-source="why-cps" class="btn-primary">
            <span>Get Started Today</span>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a href="/services" class="btn-outline">
            View Our Services
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
